<div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8 space-y-6">
  <!-- Header -->
  <div class="border-b pb-5 border-slate-200 dark:border-slate-700 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Student Analytics</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
        <%= metrics.student.fullName %> &bull; RA: <span class="font-mono text-slate-700 dark:text-slate-300 font-semibold"><%= metrics.student.raNumber %></span> &bull; <%= metrics.student.department %> (Year <%= metrics.student.year %>, Sec <%= metrics.student.section %>)
      </p>
    </div>
    <div>
      <a href="/student/profile" class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition-colors">
        View Student Profile & Portfolio
      </a>
    </div>
  </div>

  <!-- KPI Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-5">
    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Events Attended</p>
      <p class="text-3xl font-black text-emerald-600 dark:text-emerald-400 mt-2"><%= metrics.eventsAttended %></p>
      <p class="text-xs text-slate-400 mt-1">Confirmed Present</p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Registrations</p>
      <p class="text-3xl font-black text-slate-900 dark:text-white mt-2"><%= metrics.registrationsCount %></p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">OD Requests</p>
      <p class="text-3xl font-black text-indigo-600 dark:text-indigo-400 mt-2"><%= metrics.odTotalRequests %></p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">OD Approval Rate</p>
      <p class="text-3xl font-black text-amber-500 dark:text-amber-400 mt-2"><%= metrics.odApprovalRate %>%</p>
      <p class="text-xs text-slate-400 mt-1"><%= metrics.odApprovedCount %> approved / <%= metrics.odDecidedCount %> decided</p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Certificates</p>
      <p class="text-3xl font-black text-blue-600 dark:text-blue-400 mt-2"><%= metrics.certificatesCount %></p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Badges Earned</p>
      <p class="text-3xl font-black text-purple-600 dark:text-purple-400 mt-2"><%= metrics.badgesCount %></p>
    </div>
  </div>

  <!-- Summary Panels & Empty States -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-700">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">Event Participation Overview</h3>
      <% if (metrics.registrationsCount === 0) { %>
        <div class="p-8 text-center bg-slate-50 dark:bg-slate-900/50 rounded-lg border border-dashed border-slate-300 dark:border-slate-700">
          <p class="text-slate-500 dark:text-slate-400 font-medium">You haven't registered for any events yet.</p>
          <a href="/events" class="inline-block mt-3 text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline">Explore Approved Events &rarr;</a>
        </div>
      <% } else { %>
        <div class="space-y-4">
          <div class="flex items-center justify-between p-4 bg-slate-50 dark:bg-slate-900/60 rounded-lg">
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Participation Ratio (Attended / Registered)</span>
            <span class="text-lg font-extrabold text-emerald-600">
              <%= metrics.registrationsCount > 0 ? ((metrics.eventsAttended / metrics.registrationsCount) * 100).toFixed(1) : '0.0' %>%
            </span>
          </div>
          <div class="flex items-center justify-between p-4 bg-slate-50 dark:bg-slate-900/60 rounded-lg">
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Certificates Earned Rate</span>
            <span class="text-lg font-extrabold text-blue-600">
              <%= metrics.eventsAttended > 0 ? ((metrics.certificatesCount / metrics.eventsAttended) * 100).toFixed(1) : '0.0' %>%
            </span>
          </div>
        </div>
      <% } %>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-700">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">On-Duty (OD) Request Status</h3>
      <% if (metrics.odTotalRequests === 0) { %>
        <div class="p-8 text-center bg-slate-50 dark:bg-slate-900/50 rounded-lg border border-dashed border-slate-300 dark:border-slate-700">
          <p class="text-slate-500 dark:text-slate-400 font-medium">No On-Duty requests filed yet.</p>
        </div>
      <% } else { %>
        <div class="space-y-3">
          <div class="flex justify-between items-center text-sm p-3 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-800 dark:text-emerald-300 rounded-lg font-medium">
            <span>Approved Requests</span>
            <span class="font-bold text-lg"><%= metrics.odApprovedCount %></span>
          </div>
          <div class="flex justify-between items-center text-sm p-3 bg-red-50 dark:bg-red-900/20 text-red-800 dark:text-red-300 rounded-lg font-medium">
            <span>Rejected Requests</span>
            <span class="font-bold text-lg"><%= metrics.odRejectedCount %></span>
          </div>
          <div class="flex justify-between items-center text-sm p-3 bg-amber-50 dark:bg-amber-900/20 text-amber-800 dark:text-amber-300 rounded-lg font-medium">
            <span>Pending Mentor Decision</span>
            <span class="font-bold text-lg"><%= metrics.odTotalRequests - metrics.odDecidedCount %></span>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div class="space-y-8">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Browse Campus Events</h1>
      <p class="text-sm text-slate-400 mt-1">Discover approved club workshops, hackathons, and activities</p>
    </div>
    <div>
      <a href="/student/my-registrations" class="inline-flex items-center space-x-2 px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-indigo-400 font-semibold text-xs rounded-xl transition border border-slate-700">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        <span>My Registrations</span>
      </a>
    </div>
  </div>

  <!-- Alerts -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Search & Filters Container -->
  <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-5 shadow-xl space-y-4">
    <form action="/student/events" method="GET" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 items-end">
      <!-- Search -->
      <div class="sm:col-span-2">
        <label for="search" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Search Events</label>
        <input type="text" id="search" name="search" value="<%= search %>" placeholder="Search by title, description or venue..." class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs focus:outline-none focus:border-indigo-500 transition">
      </div>

      <!-- Club Filter -->
      <div>
        <label for="clubId" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Club</label>
        <select id="clubId" name="clubId" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs">
          <option value="">All Active Clubs</option>
          <% clubs.forEach(c => { %>
            <option value="<%= c.id %>" <%= selectedClubId === c.id ? 'selected' : '' %>><%= c.name %> (<%= c.code %>)</option>
          <% }) %>
        </select>
      </div>

      <!-- Date Filter -->
      <div>
        <label for="date" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Event Date</label>
        <input type="date" id="date" name="date" value="<%= dateFilter %>" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs">
      </div>

      <!-- My Clubs Only Checkbox & Submit Buttons -->
      <div class="sm:col-span-2 md:col-span-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
        <label class="flex items-center space-x-2 cursor-pointer">
          <input type="checkbox" name="myClubsOnly" value="true" <%= myClubsOnly ? 'checked' : '' %> class="w-4 h-4 text-indigo-600 bg-slate-900 border-slate-600 rounded">
          <span class="text-xs font-semibold text-slate-300">Show My Joined Clubs Only</span>
        </label>

        <div class="flex items-center space-x-2">
          <a href="/student/events" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs rounded-xl transition">Reset</a>
          <button type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl transition shadow-md shadow-indigo-600/30">
            Apply Filters
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Approved Events Cards Grid (Mobile-friendly) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (events.length === 0) { %>
      <div class="col-span-full p-8 bg-slate-800/40 border border-slate-700/40 rounded-2xl text-center text-slate-400 text-sm">
        No approved events match your current search or filter criteria.
      </div>
    <% } %>

    <% events.forEach(e => { %>
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl overflow-hidden shadow-xl flex flex-col justify-between hover:border-indigo-500/50 transition">
        <div>
          <!-- Banner -->
          <div class="relative h-44 bg-slate-900 border-b border-slate-700/60">
            <% if (e.banner_url) { %>
              <img src="<%= e.banner_url %>" alt="<%= e.title %> Banner" class="w-full h-full object-cover">
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-indigo-900/40 to-slate-900">
                <span class="text-indigo-400 font-extrabold text-2xl tracking-widest uppercase"><%= e.club_name %></span>
              </div>
            <% } %>

            <!-- Capacity State Badge Overlay -->
            <div class="absolute top-3 right-3 flex items-center space-x-1">
              <% if (e.is_registered) { %>
                <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-500/90 text-white shadow-md">Registered</span>
              <% } else if (e.is_full) { %>
                <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-500/90 text-white shadow-md">Full (0 Seats)</span>
              <% } else { %>
                <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-indigo-600/90 text-white shadow-md font-mono"><%= e.seats_remaining %> Seats Left</span>
              <% } %>
            </div>
          </div>

          <!-- Content -->
          <div class="p-5 space-y-3">
            <div class="flex items-center space-x-2">
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20"><%= e.club_name %></span>
            </div>

            <h3 class="text-lg font-bold text-white tracking-tight leading-snug">
              <a href="/student/events/<%= e.id %>" class="hover:text-indigo-400 transition"><%= e.title %></a>
            </h3>

            <p class="text-xs text-slate-300 line-clamp-2"><%= e.description %></p>

            <div class="space-y-1.5 pt-2 text-xs text-slate-400 border-t border-slate-700/60">
              <div class="flex items-center space-x-1.5">
                <svg class="w-4 h-4 text-slate-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span>📅 <strong><%= e.event_date %></strong> (<%= e.start_time %> - <%= e.end_time %>)</span>
              </div>
              <div class="flex items-center space-x-1.5">
                <svg class="w-4 h-4 text-slate-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
                <span>📍 <strong><%= e.venue %></strong></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Footer Action -->
        <div class="p-5 pt-0">
          <a href="/student/events/<%= e.id %>" class="w-full py-2.5 block text-center bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl transition shadow-md shadow-indigo-600/30">
            View Details & Register &rarr;
          </a>
        </div>
      </div>
    <% }) %>
  </div>

</div>

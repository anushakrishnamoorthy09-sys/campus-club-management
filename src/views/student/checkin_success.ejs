<div class="max-w-md mx-auto py-12">
  <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-6 sm:p-8 text-center shadow-2xl space-y-6">
    
    <!-- Success Icon Header -->
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 mx-auto shadow-lg shadow-emerald-500/10">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>

    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-emerald-400 mb-1">Attendance Confirmed</div>
      <h1 class="text-2xl font-extrabold text-white tracking-tight"><%= event.title %></h1>
      <p class="text-xs text-slate-400 mt-1">Organized by <span class="text-indigo-300 font-semibold"><%= event.club_name %></span></p>
    </div>

    <!-- Attendance Details Card -->
    <div class="bg-slate-900/80 rounded-xl p-4 border border-slate-700/60 text-left space-y-2 text-xs font-mono">
      <div class="flex justify-between border-b border-slate-800 pb-2">
        <span class="text-slate-400">Student Name:</span>
        <span class="text-white font-bold"><%= student.full_name %></span>
      </div>
      <div class="flex justify-between border-b border-slate-800 pb-2">
        <span class="text-slate-400">RA Number:</span>
        <span class="text-indigo-400 font-bold"><%= student.ra_number %></span>
      </div>
      <div class="flex justify-between border-b border-slate-800 pb-2">
        <span class="text-slate-400">Method:</span>
        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
          <%= attRecord.method || 'QR' %>
        </span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Status:</span>
        <span class="text-emerald-400 font-bold">PRESENT</span>
      </div>
    </div>

    <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 rounded-xl text-emerald-300 text-xs">
      🎉 A confirmation notification has been sent to your student portal.
    </div>

    <div class="pt-2 flex flex-col sm:flex-row gap-3">
      <a href="/student/events/<%= event.id %>" class="flex-1 py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl transition text-center shadow-lg shadow-indigo-600/30">
        View Event Details
      </a>
      <a href="/student/my-registrations" class="flex-1 py-2.5 px-4 bg-slate-700 hover:bg-slate-600 text-slate-200 font-bold text-xs rounded-xl transition text-center border border-slate-600">
        My Registrations
      </a>
    </div>

  </div>
</div>

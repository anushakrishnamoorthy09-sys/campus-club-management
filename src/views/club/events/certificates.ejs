<div class="space-y-8">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-1">Certificate Management</div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight"><%= event.title %></h1>
      <p class="text-sm text-slate-400 mt-1">
        Club: <span class="text-indigo-300 font-semibold"><%= event.club_name %></span> | 
        Status: <span class="px-2 py-0.5 rounded text-xs font-bold <%= isCompleted ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-400 border border-amber-500/30' %>"><%= event.status %></span>
      </p>
    </div>
    <div class="flex items-center space-x-2">
      <a href="/club/events/<%= event.id %>" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs rounded-xl border border-slate-700 transition">
        &larr; Back to Event
      </a>
    </div>
  </div>

  <!-- Alerts -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-start space-x-2">
      <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <div>
        <strong class="font-bold block">Certificate Error</strong>
        <span><%= error %></span>
      </div>
    </div>
  <% } %>

  <!-- Read-Only Banner if Event is NOT COMPLETED -->
  <% if (!isCompleted) { %>
    <div class="p-5 bg-amber-500/10 border border-amber-500/20 rounded-2xl text-amber-300 text-sm flex items-start space-x-3">
      <svg class="w-6 h-6 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      <div>
        <strong class="font-bold text-base block text-amber-200">Certificate Issuance Locked (Event Status: <%= event.status %>)</strong>
        <span>Certificates can only be issued once the event is marked <strong>COMPLETED</strong>. Please wait until the event concludes to issue certificates to confirmed attendees.</span>
      </div>
    </div>
  <% } else { %>

    <!-- Summary Metrics & Bulk Issue Control -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">

      <div class="md:col-span-7 grid grid-cols-3 gap-4">
        <div class="p-4 bg-slate-800/60 border border-slate-700/60 rounded-2xl">
          <div class="text-slate-400 text-xs font-bold uppercase tracking-wider font-mono">Present Attendees</div>
          <div class="text-2xl font-extrabold text-white mt-1"><%= summary.totalPresent %></div>
        </div>
        <div class="p-4 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl">
          <div class="text-emerald-400 text-xs font-bold uppercase tracking-wider font-mono">Certificates Issued</div>
          <div class="text-2xl font-extrabold text-emerald-400 mt-1"><%= summary.issuedCount %></div>
        </div>
        <div class="p-4 bg-amber-500/10 border border-amber-500/20 rounded-2xl">
          <div class="text-amber-400 text-xs font-bold uppercase tracking-wider font-mono">Unissued</div>
          <div class="text-2xl font-extrabold text-amber-400 mt-1"><%= summary.unissuedCount %></div>
        </div>
      </div>

      <div class="md:col-span-5 bg-slate-800/60 border border-slate-700/60 rounded-2xl p-4 flex flex-col justify-between">
        <div>
          <h3 class="text-sm font-bold text-white mb-1">Bulk Certificate Issuance</h3>
          <p class="text-xs text-slate-400">Issue certificates to all confirmed PRESENT attendees who do not have one yet.</p>
        </div>

        <form action="/club/events/<%= event.id %>/certificates/bulk-issue" method="POST" class="mt-3 flex items-center space-x-2" onsubmit="return confirm('Issue certificates to all remaining present attendees?');">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <select name="defaultRole" class="px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs font-semibold focus:outline-none">
            <% allowedRoles.forEach(role => { %>
              <option value="<%= role %>"><%= role %></option>
            <% }) %>
          </select>
          <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl shadow-md shadow-indigo-600/30 transition flex-1">
            Bulk Issue All
          </button>
        </form>
      </div>

    </div>

  <% } %>

  <!-- Attendees Roster & Issued Certificates Table -->
  <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl overflow-hidden shadow-xl">
    <div class="p-4 bg-slate-900/80 border-b border-slate-700/60 flex items-center justify-between">
      <h2 class="text-sm font-bold text-white uppercase tracking-wider font-mono">Confirmed Attendees Roster</h2>
      <span class="text-xs text-slate-400">Only students marked PRESENT are eligible</span>
    </div>

    <% if (roster.length === 0) { %>
      <div class="p-8 text-center text-slate-400 text-sm">
        No present attendees found for this event yet. Mark attendance first.
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-900/80 text-slate-400 uppercase font-mono font-bold border-b border-slate-700/60">
            <tr>
              <th class="py-3.5 px-4">Student</th>
              <th class="py-3.5 px-4">RA Number</th>
              <th class="py-3.5 px-4">Department</th>
              <th class="py-3.5 px-4 text-center">Status & Role</th>
              <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-700/40">
            <% roster.forEach(student => { %>
              <tr class="hover:bg-slate-700/20 transition">
                
                <td class="py-3.5 px-4">
                  <div class="font-bold text-white text-sm"><%= student.student_name %></div>
                  <div class="text-[11px] text-slate-400 font-mono"><%= student.email %></div>
                </td>

                <td class="py-3.5 px-4 font-mono font-bold text-indigo-400">
                  <%= student.ra_number %>
                </td>

                <td class="py-3.5 px-4">
                  <div class="font-semibold text-slate-200"><%= student.department %></div>
                  <div class="text-[11px] text-slate-400">Year <%= student.year_of_study %></div>
                </td>

                <td class="py-3.5 px-4 text-center">
                  <% if (student.certificate_id && student.cert_status === 'ISSUED') { %>
                    <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                      ISSUED (<%= student.role_type %>)
                    </span>
                    <div class="text-[10px] text-slate-400 font-mono mt-1">UUID: <%= student.certificate_uuid.substring(0, 8) %>...</div>
                  <% } else if (student.certificate_id && student.cert_status === 'REVOKED') { %>
                    <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30">
                      REVOKED
                    </span>
                    <div class="text-[10px] text-rose-400 mt-1"><%= student.revocation_reason %></div>
                  <% } else { %>
                    <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                      NOT ISSUED
                    </span>
                  <% } %>
                </td>

                <td class="py-3.5 px-4 text-right">
                  <% if (isCompleted) { %>
                    <% if (!student.certificate_id || student.cert_status === 'REVOKED') { %>
                      <form action="/club/events/<%= event.id %>/certificates/issue" method="POST" class="inline-flex items-center space-x-2">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <input type="hidden" name="studentUserId" value="<%= student.student_user_id %>">
                        <select name="roleType" class="px-2 py-1 bg-slate-900 border border-slate-700 rounded-lg text-white text-[11px]">
                          <% allowedRoles.forEach(r => { %>
                            <option value="<%= r %>"><%= r %></option>
                          <% }) %>
                        </select>
                        <button type="submit" class="px-3 py-1 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-lg transition shadow-sm">
                          Issue
                        </button>
                      </form>
                    <% } else { %>
                      <div class="inline-flex items-center space-x-2">
                        <a href="/student/certificates/<%= student.certificate_uuid %>/download" target="_blank" class="px-2.5 py-1 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-bold rounded-lg transition">
                          View PDF
                        </a>
                        <button type="button" onclick="openRevokeModal('<%= student.certificate_id %>', '<%= student.student_name %>', '<%= student.certificate_uuid %>')" class="px-2.5 py-1 bg-rose-600/80 hover:bg-rose-600 text-white text-xs font-bold rounded-lg transition">
                          Revoke
                        </button>
                      </div>
                    <% } %>
                  <% } else { %>
                    <span class="text-xs text-slate-500 font-mono">Locked</span>
                  <% } %>
                </td>

              </tr>
            <% }) %>
          <% } %>
        </table>
      </div>
    <% } %>
  </div>

</div>

<!-- Revoke Modal -->
<div id="revokeModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-slate-800 border border-slate-700 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
    <h3 class="text-lg font-bold text-white">Revoke Certificate</h3>
    <p class="text-xs text-slate-300">Are you sure you want to revoke the certificate for <strong id="modalStudentName" class="text-indigo-400"></strong>?</p>
    
    <form id="revokeForm" method="POST" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div>
        <label for="reason" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Revocation Reason (Mandatory)</label>
        <textarea name="reason" id="reason" required rows="3" placeholder="Enter reason for revocation..." class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs placeholder-slate-500 focus:outline-none focus:border-rose-500"></textarea>
      </div>

      <div class="flex justify-end space-x-3 pt-2">
        <button type="button" onclick="closeRevokeModal()" class="px-4 py-2 bg-slate-700 text-slate-300 text-xs font-bold rounded-xl hover:bg-slate-600">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-rose-600 text-white text-xs font-bold rounded-xl hover:bg-rose-500">Confirm Revocation</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openRevokeModal(certId, studentName, certUuid) {
    document.getElementById('modalStudentName').innerText = studentName;
    document.getElementById('revokeForm').action = `/club/events/<%= event.id %>/certificates/${certId}/revoke`;
    document.getElementById('revokeModal').classList.remove('hidden');
  }

  function closeRevokeModal() {
    document.getElementById('revokeModal').classList.add('hidden');
  }
</script>

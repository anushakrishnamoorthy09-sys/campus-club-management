<div class="space-y-8">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <a href="/club/events/<%= event.id %>" class="text-xs text-indigo-400 hover:underline mb-2 inline-block">&larr; Back to Event Detail</a>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Registration Roster - <%= event.title %></h1>
      <p class="text-sm text-slate-400 mt-1">
        <%= registrations.length %> Registered Students / Capacity <%= event.capacity %>
      </p>
    </div>
  </div>

  <!-- Alerts -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Registrations Roster Table -->
  <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-slate-900/80 text-slate-400 text-xs uppercase tracking-wider border-b border-slate-700">
            <th class="py-3.5 px-6 font-semibold">Student Name</th>
            <th class="py-3.5 px-6 font-semibold">RA Number</th>
            <th class="py-3.5 px-6 font-semibold">Department</th>
            <th class="py-3.5 px-6 font-semibold">Registered Time</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-700/60 text-slate-300">
          <% if (registrations.length === 0) { %>
            <tr>
              <td colspan="4" class="py-8 text-center text-slate-400 text-sm italic">
                No student registrations recorded for this event yet.
              </td>
            </tr>
          <% } %>

          <% registrations.forEach(r => { %>
            <tr class="hover:bg-slate-800/40 transition">
              <td class="py-4 px-6">
                <div class="font-semibold text-white"><%= r.student_name %></div>
                <div class="text-xs text-slate-400"><%= r.email %></div>
              </td>
              <td class="py-4 px-6 font-mono font-semibold text-indigo-400 text-xs">
                <%= r.ra_number %>
              </td>
              <td class="py-4 px-6 text-xs text-slate-300">
                <%= r.department || 'N/A' %>
              </td>
              <td class="py-4 px-6 text-xs text-slate-400">
                <%= r.registered_at %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

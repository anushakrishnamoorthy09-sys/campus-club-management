<div class="max-w-4xl mx-auto space-y-8">

  <!-- Header -->
  <div class="flex items-center justify-between pb-6 border-b border-slate-800">
    <div>
      <a href="/club/events" class="text-xs text-indigo-400 hover:underline mb-2 inline-block">&larr; Back to Events List</a>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
        <%= isEdit ? 'Edit Event' : 'Create New Event' %> - <%= club.name %>
      </h1>
      <p class="text-sm text-slate-400 mt-1">
        <%= isEdit ? 'Modify event details. Note: Material schedule or capacity edits on APPROVED events will re-trigger PENDING_APPROVAL review.' : 'Fill out the event details to create a new draft event.' %>
      </p>
    </div>
  </div>

  <!-- General Error Alert -->
  <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span><%= errorMsg %></span>
    </div>
  <% } %>

  <form action="<%= isEdit ? '/club/events/' + event.id + '/edit' : '/club/events/new' %>" method="POST" enctype="multipart/form-data" class="space-y-6">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <% if (isEdit) { %>
      <input type="hidden" id="event_id" value="<%= event.id %>">
    <% } %>

    <!-- Title -->
    <div>
      <label for="title" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Event Title *</label>
      <input type="text" id="title" name="title" required value="<%= event.title || '' %>" placeholder="e.g. AI & Robotics Hackathon 2026" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition">
      <% if (errors && errors.title) { %>
        <p class="text-xs text-rose-400 mt-1"><%= errors.title %></p>
      <% } %>
    </div>

    <!-- Description -->
    <div>
      <label for="description" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Description *</label>
      <textarea id="description" name="description" rows="4" required placeholder="Describe the objectives, agenda, and target audience for the event..." class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition"><%= event.description || '' %></textarea>
      <% if (errors && errors.description) { %>
        <p class="text-xs text-rose-400 mt-1"><%= errors.description %></p>
      <% } %>
    </div>

    <!-- Venue & Capacity -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="venue" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Venue / Location *</label>
        <input type="text" id="venue" name="venue" required value="<%= event.venue || '' %>" placeholder="e.g. Main Auditorium / Tech Block Lab 3" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition">
        <% if (errors && errors.venue) { %>
          <p class="text-xs text-rose-400 mt-1"><%= errors.venue %></p>
        <% } %>
      </div>

      <div>
        <label for="capacity" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Max Capacity *</label>
        <input type="number" id="capacity" name="capacity" min="1" required value="<%= event.capacity || 50 %>" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition">
        <% if (errors && errors.capacity) { %>
          <p class="text-xs text-rose-400 mt-1"><%= errors.capacity %></p>
        <% } %>
      </div>
    </div>

    <!-- Date & Times -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label for="event_date" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Event Date (YYYY-MM-DD) *</label>
        <input type="date" id="event_date" name="event_date" required value="<%= event.event_date || '' %>" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition">
        <% if (errors && errors.event_date) { %>
          <p class="text-xs text-rose-400 mt-1"><%= errors.event_date %></p>
        <% } %>
      </div>

      <div>
        <label for="start_time" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Start Time (HH:MM) *</label>
        <input type="time" id="start_time" name="start_time" required value="<%= event.start_time || '' %>" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition">
        <% if (errors && errors.start_time) { %>
          <p class="text-xs text-rose-400 mt-1"><%= errors.start_time %></p>
        <% } %>
      </div>

      <div>
        <label for="end_time" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">End Time (HH:MM) *</label>
        <input type="time" id="end_time" name="end_time" required value="<%= event.end_time || '' %>" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition">
        <% if (errors && errors.end_time) { %>
          <p class="text-xs text-rose-400 mt-1"><%= errors.end_time %></p>
        <% } %>
      </div>
    </div>

    <!-- LIVE Academic-Impact Preview Container (Required Feature) -->
    <div id="impact-preview-card" class="p-5 bg-indigo-950/40 border border-indigo-500/30 rounded-2xl space-y-2">
      <div class="flex items-center space-x-2 text-indigo-400 font-bold text-xs uppercase tracking-wider">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>Live Academic Impact & Venue Conflict Analysis</span>
      </div>

      <div id="impact-details" class="text-sm text-slate-200 font-medium">
        Select event date and start/end times to view live timetable period impact...
      </div>

      <div id="venue-conflict-details" class="text-xs text-amber-400 hidden">
        <!-- Conflict hints inserted dynamically -->
      </div>
    </div>

    <!-- Banner Options: URL or Upload -->
    <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-5 space-y-4">
      <h3 class="text-sm font-bold text-white">Event Banner Image (Optional)</h3>

      <div>
        <label for="banner_url" class="block text-xs font-semibold text-slate-400 mb-1">Banner Image URL</label>
        <input type="url" id="banner_url" name="banner_url" value="<%= event.banner_url || '' %>" placeholder="https://example.com/banner.png" class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs">
      </div>

      <div class="relative flex py-1 items-center">
        <div class="flex-grow border-t border-slate-700"></div>
        <span class="flex-shrink mx-4 text-slate-500 text-xs uppercase">OR UPLOAD IMAGE</span>
        <div class="flex-grow border-t border-slate-700"></div>
      </div>

      <div>
        <label for="banner_file" class="block text-xs font-semibold text-slate-400 mb-1">Upload Image File (PNG, JPG, WEBP, max 2 MB)</label>
        <input type="file" id="banner_file" name="banner_file" accept="image/png,image/jpeg,image/jpg,image/webp" class="block w-full text-xs text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-indigo-600 file:text-white hover:file:bg-indigo-500 transition">
      </div>
    </div>

    <!-- Submit Button -->
    <div class="pt-4 flex items-center space-x-4">
      <button type="submit" class="px-6 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm rounded-xl transition shadow-lg shadow-indigo-600/30">
        <%= isEdit ? 'Save Changes' : 'Create Draft Event' %>
      </button>
      <a href="/club/events" class="px-4 py-3 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-sm rounded-xl transition">
        Cancel
      </a>
    </div>
  </form>

</div>

<!-- Client-side Script for Live Academic Impact Preview -->
<script>
  (function() {
    const dateEl = document.getElementById('event_date');
    const startEl = document.getElementById('start_time');
    const endEl = document.getElementById('end_time');
    const venueEl = document.getElementById('venue');
    const eventIdEl = document.getElementById('event_id');

    const impactDetails = document.getElementById('impact-details');
    const venueDetails = document.getElementById('venue-conflict-details');

    async function checkImpact() {
      const dateVal = dateEl ? dateEl.value : '';
      const startVal = startEl ? startEl.value : '';
      const endVal = endEl ? endEl.value : '';
      const venueVal = venueEl ? venueEl.value : '';
      const eventIdVal = eventIdEl ? eventIdEl.value : '';

      if (!dateVal || !startVal || !endVal) {
        impactDetails.innerHTML = '<span class="text-slate-400 italic">Enter date, start time, and end time to calculate affected class periods.</span>';
        venueDetails.classList.add('hidden');
        return;
      }

      try {
        const url = `/club/events/preview-impact?event_date=${encodeURIComponent(dateVal)}&start_time=${encodeURIComponent(startVal)}&end_time=${encodeURIComponent(endVal)}&venue=${encodeURIComponent(venueVal)}${eventIdVal ? '&event_id=' + eventIdVal : ''}`;
        const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
        if (!res.ok) return;
        const data = await res.json();

        const { impact, conflicts } = data;

        // Render Impact text
        if (!impact.active) {
          if (impact.reason === 'NO_ACTIVE_STRUCTURE') {
            impactDetails.innerHTML = '<span class="text-slate-400">ℹ️ No active timetable structure found for this date.</span>';
          } else if (impact.reason === 'NON_WORKING_DAY') {
            impactDetails.innerHTML = '<span class="text-emerald-400">✅ No academic impact (Non-working day / Weekend).</span>';
          } else {
            impactDetails.innerHTML = '<span class="text-slate-400">No timetable conflict data.</span>';
          }
        } else if (impact.reason === 'ONLY_BREAKS') {
          impactDetails.innerHTML = '<span class="text-emerald-400">✅ Occurs during break periods (No class periods affected).</span>';
        } else if (impact.periods && impact.periods.length > 0) {
          const firstP = impact.periods[0];
          const lastP = impact.periods[impact.periods.length - 1];
          const pNums = impact.periods.map(p => p.period_number).join(', ');

          let pRange = `Period ${firstP.period_number}`;
          if (impact.periods.length > 1) {
            pRange = `Periods ${firstP.period_number}-${lastP.period_number}`;
          }

          impactDetails.innerHTML = `<span class="text-indigo-300 font-bold">⚠️ Academic Impact:</span> Affects <span class="text-white font-bold">${pRange}</span> (${firstP.start_time} to ${lastP.end_time}) [Detailed periods: #${pNums}]`;
        } else {
          impactDetails.innerHTML = '<span class="text-emerald-400">✅ No class periods affected.</span>';
        }

        // Render Venue Conflicts
        if (conflicts && conflicts.length > 0) {
          const cNames = conflicts.map(c => `'${c.title}' (${c.start_time}-${c.end_time})`).join(', ');
          venueDetails.innerHTML = `⚠️ <strong class="font-bold">Venue Conflict Hint:</strong> ${conflicts.length} overlapping event(s) found at '${venueVal}': ${cNames}`;
          venueDetails.classList.remove('hidden');
        } else {
          venueDetails.classList.add('hidden');
        }
      } catch (err) {
        console.error('Impact check error:', err);
      }
    }

    [dateEl, startEl, endEl, venueEl].forEach(el => {
      if (el) {
        el.addEventListener('change', checkImpact);
        el.addEventListener('input', checkImpact);
      }
    });

    // Run initial check if values present
    checkImpact();
  })();
</script>

<div class="space-y-8 max-w-5xl mx-auto py-4">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-1">Live QR Attendance Check-In</div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight"><%= event.title %></h1>
      <p class="text-sm text-slate-400 mt-1">
        Club: <span class="text-indigo-300 font-semibold"><%= event.club_name %></span> | 
        Status: <span class="px-2 py-0.5 rounded text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">ONGOING</span>
      </p>
    </div>
    <div class="flex items-center space-x-3">
      <a href="/club/events/<%= event.id %>/attendance" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs rounded-xl border border-slate-700 transition">
        &larr; Back to Roster
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- QR Display Box (Left Column) -->
    <div class="lg:col-span-6 bg-slate-800/80 border border-slate-700/80 rounded-2xl p-6 sm:p-8 text-center shadow-2xl flex flex-col items-center">
      <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 flex items-center space-x-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
        <span>Displaying Live Dynamic QR Code</span>
      </div>

      <div class="bg-white p-4 rounded-2xl shadow-inner inline-block my-2">
        <img id="qrImage" src="<%= qrDataUrl %>" alt="Check-in QR Code" class="w-64 h-64 sm:w-80 sm:h-80 mx-auto object-contain">
      </div>

      <div class="mt-4 space-y-1 text-center">
        <p class="text-xs text-slate-400 font-mono">Scans lead to: <span class="text-indigo-400 font-bold">/checkin?t=...</span></p>
        <p class="text-[11px] text-slate-500">Refreshes automatically every 20 seconds. Valid for ~60 seconds.</p>
      </div>

      <!-- Auto Refresh Progress Bar -->
      <div class="w-full bg-slate-900 h-1.5 rounded-full mt-6 overflow-hidden">
        <div id="refreshBar" class="bg-indigo-500 h-full w-full transition-all duration-1000 ease-linear"></div>
      </div>
    </div>

    <!-- Live Counter & Recent Check-ins List (Right Column) -->
    <div class="lg:col-span-6 space-y-6">

      <!-- Realtime Metric Cards -->
      <div class="grid grid-cols-2 gap-4">
        <div class="p-5 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl text-center">
          <div class="text-emerald-400 text-xs font-bold uppercase tracking-wider font-mono">Present Count</div>
          <div class="text-3xl font-extrabold text-emerald-400 mt-2" id="presentCount"><%= summary.presentCount %></div>
        </div>

        <div class="p-5 bg-slate-800/60 border border-slate-700/60 rounded-2xl text-center">
          <div class="text-slate-400 text-xs font-bold uppercase tracking-wider font-mono">Total Registered</div>
          <div class="text-3xl font-extrabold text-white mt-2" id="totalRegistered"><%= summary.totalRegistered %></div>
        </div>
      </div>

      <!-- Live Stream Roster Table -->
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl overflow-hidden shadow-xl">
        <div class="p-4 bg-slate-900/80 border-b border-slate-700/60 flex items-center justify-between">
          <h3 class="text-sm font-bold text-white flex items-center space-x-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>Recent Live Check-Ins</span>
          </h3>
          <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Polling live</span>
        </div>

        <div class="divide-y divide-slate-700/40 max-h-96 overflow-y-auto" id="recentCheckinsList">
          <% if (recentCheckins.length === 0) { %>
            <div class="p-6 text-center text-slate-400 text-xs" id="emptyCheckinsMsg">
              No students have checked in via QR yet. Scan the code to begin!
            </div>
          <% } else { %>
            <% recentCheckins.forEach(item => { %>
              <div class="p-3.5 flex items-center justify-between hover:bg-slate-700/20 transition">
                <div>
                  <div class="font-bold text-white text-xs"><%= item.student_name %></div>
                  <div class="text-[11px] text-indigo-400 font-mono"><%= item.ra_number %> (<%= item.department %>)</div>
                </div>
                <div class="text-right">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                    <%= item.method || 'QR' %>
                  </span>
                  <div class="text-[10px] text-slate-500 font-mono mt-0.5"><%= item.marked_at %></div>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

    </div>
  </div>

</div>

<script>
  const eventId = <%= event.id %>;
  let countdownSec = 20;

  function fetchLiveData() {
    fetch(`/club/events/${eventId}/checkin/qr`)
      .then(res => res.json())
      .then(data => {
        if (data.error) return;

        // Update QR Image
        if (data.qrDataUrl) {
          document.getElementById('qrImage').src = data.qrDataUrl;
        }

        // Update Counter
        if (data.summary) {
          document.getElementById('presentCount').innerText = data.summary.presentCount;
          document.getElementById('totalRegistered').innerText = data.summary.totalRegistered;
        }

        // Update Recent Checkins
        if (data.recentCheckins && data.recentCheckins.length > 0) {
          const container = document.getElementById('recentCheckinsList');
          let html = '';
          data.recentCheckins.forEach(item => {
            html += `
              <div class="p-3.5 flex items-center justify-between hover:bg-slate-700/20 transition">
                <div>
                  <div class="font-bold text-white text-xs">${item.student_name}</div>
                  <div class="text-[11px] text-indigo-400 font-mono">${item.ra_number} (${item.department})</div>
                </div>
                <div class="text-right">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                    ${item.method || 'QR'}
                  </span>
                  <div class="text-[10px] text-slate-500 font-mono mt-0.5">${item.marked_at || ''}</div>
                </div>
              </div>
            `;
          });
          container.innerHTML = html;
        }
      })
      .catch(err => console.error('Checkin poll error:', err));
  }

  // Poll live data & update QR every 3 seconds
  setInterval(fetchLiveData, 3000);

  // Smooth Progress Bar Animation for 20-second QR refresh
  setInterval(() => {
    countdownSec -= 1;
    if (countdownSec <= 0) {
      countdownSec = 20;
    }
    const pct = (countdownSec / 20) * 100;
    const bar = document.getElementById('refreshBar');
    if (bar) bar.style.width = pct + '%';
  }, 1000);
</script>

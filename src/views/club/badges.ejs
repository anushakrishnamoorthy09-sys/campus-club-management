<div class="space-y-8">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-1">Badge Management</div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight"><%= club.name %> Badges</h1>
      <p class="text-sm text-slate-400 mt-1">Create custom club milestone badges and award them to active members</p>
    </div>
  </div>

  <!-- Alerts -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-start space-x-2">
      <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <div>
        <strong class="font-bold block">Badge Error</strong>
        <span><%= error %></span>
      </div>
    </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Left Column: Create Badge Type & Badge Catalog -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Create Badge Type Form -->
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-4">
        <h3 class="text-base font-bold text-white flex items-center space-x-2">
          <span>✨ Create Custom Badge Type</span>
        </h3>

        <form action="/club/badges/types/new" method="POST" class="space-y-4">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

          <div>
            <label for="name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Badge Name</label>
            <input type="text" id="name" name="name" required placeholder="e.g. Hackathon Champion" class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs placeholder-slate-500 focus:outline-none focus:border-indigo-500">
          </div>

          <div>
            <label for="description" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Description</label>
            <textarea id="description" name="description" required rows="2" placeholder="Brief milestone achievement description..." class="w-full px-3.5 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs placeholder-slate-500 focus:outline-none focus:border-indigo-500"></textarea>
          </div>

          <div>
            <label for="icon_name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Icon Style</label>
            <select id="icon_name" name="icon_name" class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs focus:outline-none">
              <% fixedIcons.forEach(icon => { %>
                <option value="<%= icon %>"><%= icon.toUpperCase() %></option>
              <% }) %>
            </select>
          </div>

          <button type="submit" class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-indigo-600/30 transition">
            Create Badge Type
          </button>
        </form>
      </div>

      <!-- Existing Badge Catalog -->
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider font-mono">Club Badge Catalog</h3>
        
        <% if (badgeTypes.length === 0) { %>
          <p class="text-xs text-slate-400">No custom badge types created for this club yet.</p>
        <% } else { %>
          <div class="space-y-3">
            <% badgeTypes.forEach(b => { %>
              <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-700/60 flex items-center justify-between">
                <div>
                  <div class="font-bold text-white text-xs flex items-center space-x-1.5">
                    <span class="px-2 py-0.5 bg-indigo-500/20 text-indigo-300 text-[10px] rounded font-mono"><%= b.icon_name %></span>
                    <span><%= b.name %></span>
                  </div>
                  <p class="text-[11px] text-slate-400 mt-1"><%= b.description %></p>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

    </div>

    <!-- Right Column: Manual Awarding & Recent Activity Roster -->
    <div class="lg:col-span-7 space-y-6">

      <!-- Manual Award Form -->
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-4">
        <h3 class="text-base font-bold text-white flex items-center space-x-2">
          <span>🏆 Award Badge to Student</span>
        </h3>

        <% if (badgeTypes.length === 0) { %>
          <p class="text-xs text-amber-400 bg-amber-500/10 p-3 rounded-xl border border-amber-500/20">
            Please create at least one badge type in the left column before awarding.
          </p>
        <% } else if (members.length === 0) { %>
          <p class="text-xs text-slate-400">No active club members found to award badges to.</p>
        <% } else { %>
          <form action="/club/badges/award" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

            <div>
              <label for="badgeTypeId" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Select Badge Type</label>
              <select id="badgeTypeId" name="badgeTypeId" required class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs focus:outline-none">
                <% badgeTypes.forEach(b => { %>
                  <option value="<%= b.id %>"><%= b.name %> (<%= b.icon_name %>)</option>
                <% }) %>
              </select>
            </div>

            <div>
              <label for="studentUserId" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Select Student Member</label>
              <select id="studentUserId" name="studentUserId" required class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs font-mono focus:outline-none">
                <% members.forEach(m => { %>
                  <option value="<%= m.student_user_id %>"><%= m.full_name %> (<%= m.ra_number %> - <%= m.department %>)</option>
                <% }) %>
              </select>
            </div>

            <div>
              <label for="reason" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Award Citation / Reason (Optional)</label>
              <input type="text" id="reason" name="reason" placeholder="e.g. Outstanding performance in annual hackathon" class="w-full px-3.5 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white text-xs placeholder-slate-500 focus:outline-none">
            </div>

            <button type="submit" class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-emerald-600/30 transition">
              Confirm & Award Badge
            </button>
          </form>
        <% } %>
      </div>

      <!-- Recent Badge Awards List -->
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl overflow-hidden shadow-xl">
        <div class="p-4 bg-slate-900/80 border-b border-slate-700/60 flex items-center justify-between">
          <h3 class="text-sm font-bold text-white uppercase tracking-wider font-mono">Recent Badge Awardings</h3>
          <span class="text-xs text-slate-400">Total: <%= recentAwards.length %></span>
        </div>

        <% if (recentAwards.length === 0) { %>
          <div class="p-8 text-center text-slate-400 text-xs">
            No badges awarded in this club yet.
          </div>
        <% } else { %>
          <div class="divide-y divide-slate-700/40 max-h-96 overflow-y-auto">
            <% recentAwards.forEach(award => { %>
              <div class="p-4 flex items-center justify-between hover:bg-slate-700/20 transition">
                <div>
                  <div class="font-bold text-white text-xs flex items-center space-x-2">
                    <span class="px-2 py-0.5 bg-indigo-500/20 text-indigo-300 font-mono text-[10px] rounded"><%= award.icon_name %></span>
                    <span><%= award.badge_name %></span>
                    <span class="text-slate-400 font-normal">awarded to</span>
                    <span class="text-emerald-400 font-bold"><%= award.student_name %></span>
                  </div>
                  <div class="text-[11px] text-slate-400 mt-1 font-mono">
                    RA: <%= award.ra_number %> | Awarded by: <%= award.awarded_by_name %> | Date: <%= award.awarded_at %>
                  </div>
                  <% if (award.reason) { %>
                    <div class="text-[11px] text-slate-300 italic mt-0.5">"<%= award.reason %>"</div>
                  <% } %>
                </div>

                <div>
                  <form action="/club/badges/<%= award.student_badge_id %>/revoke" method="POST" onsubmit="return confirm('Revoke this badge award? Mandatory reason required.');">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <input type="hidden" name="reason" value="Administrative revocation by club admin">
                    <button type="submit" class="px-2.5 py-1 bg-rose-600/80 hover:bg-rose-600 text-white font-bold text-[11px] rounded-lg transition">
                      Revoke
                    </button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

    </div>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8 space-y-6">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b pb-5 border-slate-200 dark:border-slate-700">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight"><%= metrics.club.name %> Analytics</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Club Code: <span class="font-mono font-semibold text-slate-700 dark:text-slate-300"><%= metrics.club.code %></span></p>
    </div>

    <% if (allClubs && allClubs.length > 0) { %>
      <div>
        <form method="GET" action="/club/analytics" class="flex items-center space-x-2">
          <label for="clubId" class="text-sm font-medium text-slate-700 dark:text-slate-300">Select Club:</label>
          <select id="clubId" name="clubId" onchange="this.form.submit()" class="rounded-lg border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm px-3 py-2 shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
            <% allClubs.forEach(c => { %>
              <option value="<%= c.id %>" <%= c.id === selectedClubId ? 'selected' : '' %>><%= c.name %> (<%= c.code %>)</option>
            <% }); %>
          </select>
        </form>
      </div>
    <% } %>
  </div>

  <!-- KPI Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-5">
    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Approved Members</p>
      <p class="text-3xl font-black text-slate-900 dark:text-white mt-2"><%= metrics.memberCount %></p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Completed Events</p>
      <p class="text-3xl font-black text-indigo-600 dark:text-indigo-400 mt-2"><%= metrics.completedEventsCount %></p>
      <p class="text-xs text-slate-400 mt-1">out of <%= metrics.totalEventsCount %> total</p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Registrations</p>
      <p class="text-3xl font-black text-emerald-600 dark:text-emerald-400 mt-2"><%= metrics.totalRegistrations %></p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Avg Attendance Rate</p>
      <p class="text-3xl font-black text-amber-500 dark:text-amber-400 mt-2"><%= metrics.avgAttendanceRate %>%</p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Certificates Issued</p>
      <p class="text-3xl font-black text-blue-600 dark:text-blue-400 mt-2"><%= metrics.certificatesIssued %></p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Badges Awarded</p>
      <p class="text-3xl font-black text-purple-600 dark:text-purple-400 mt-2"><%= metrics.badgesAwarded %></p>
    </div>
  </div>

  <!-- Charts & Breakdown -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Event Status Breakdown Chart -->
    <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-700">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">Event Lifecycle Status Breakdown</h3>
      <% if (metrics.totalEventsCount === 0) { %>
        <div class="p-8 text-center bg-slate-50 dark:bg-slate-900 rounded-lg border border-dashed border-slate-300 dark:border-slate-700">
          <p class="text-slate-500 dark:text-slate-400 font-medium">No events created yet for this club.</p>
        </div>
      <% } else { %>
        <div class="h-64 relative">
          <canvas id="statusChart"></canvas>
        </div>
      <% } %>
    </div>

    <!-- Attendance Performance Banners -->
    <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-700 flex flex-col justify-between">
      <div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Attendance & Engagement Summary</h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-6">Real-time breakdown of turnout efficiency across all completed events.</p>
      </div>

      <% if (metrics.completedEventsCount === 0) { %>
        <div class="p-8 text-center bg-amber-50 dark:bg-amber-900/20 rounded-lg border border-amber-200 dark:border-amber-800/40">
          <svg class="w-10 h-10 text-amber-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <p class="text-amber-800 dark:text-amber-300 font-semibold text-sm">No completed events yet</p>
          <p class="text-amber-600 dark:text-amber-400 text-xs mt-1">Attendance metrics will automatically compute as soon as an event concludes.</p>
        </div>
      <% } else { %>
        <div class="space-y-4">
          <div class="flex items-center justify-between p-4 bg-slate-50 dark:bg-slate-900/60 rounded-lg">
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Average Turnout Rate</span>
            <span class="text-lg font-extrabold text-amber-500"><%= metrics.avgAttendanceRate %>%</span>
          </div>
          <div class="flex items-center justify-between p-4 bg-slate-50 dark:bg-slate-900/60 rounded-lg">
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Certificates per Completed Event</span>
            <span class="text-lg font-extrabold text-blue-500">
              <%= (metrics.certificatesIssued / metrics.completedEventsCount).toFixed(1) %>
            </span>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<% if (metrics.totalEventsCount > 0) { %>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const ctx = document.getElementById('statusChart').getContext('2d');
    const breakdown = <%- JSON.stringify(metrics.statusBreakdown) %>;

    new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: ['Draft', 'Pending Approval', 'Approved', 'Ongoing', 'Completed', 'Rejected', 'Cancelled'],
        datasets: [{
          data: [
            breakdown.DRAFT,
            breakdown.PENDING_APPROVAL,
            breakdown.APPROVED,
            breakdown.ONGOING,
            breakdown.COMPLETED,
            breakdown.REJECTED,
            breakdown.CANCELLED
          ],
          backgroundColor: [
            '#94a3b8', // Draft
            '#f59e0b', // Pending
            '#10b981', // Approved
            '#06b6d4', // Ongoing
            '#6366f1', // Completed
            '#ef4444', // Rejected
            '#64748b'  // Cancelled
          ]
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' }
        }
      }
    });
  });
</script>
<% } %>

<!-- Recent Activity Block (Requirement 4) -->
<div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-4">
  <div class="flex items-center justify-between border-b border-slate-700/80 pb-3">
    <div class="flex items-center space-x-2">
      <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
      </svg>
      <h2 class="text-base font-bold text-white tracking-tight">Recent Activity</h2>
    </div>
    <a href="/notifications" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition">View All Notifications &rarr;</a>
  </div>

  <% if (typeof recentNotifications !== 'undefined' && recentNotifications && recentNotifications.length > 0) { %>
    <div class="divide-y divide-slate-700/50">
      <% recentNotifications.forEach(notif => { %>
        <div class="py-3 flex items-start justify-between gap-3 group">
          <div class="flex items-start space-x-3">
            <span class="mt-0.5 px-2 py-0.5 text-[10px] font-mono font-bold uppercase rounded border 
              <%= notif.type === 'EVENT' ? 'bg-sky-500/10 border-sky-500/30 text-sky-400' :
                 notif.type.includes('OD') ? 'bg-amber-500/10 border-amber-500/30 text-amber-400' :
                 notif.type.includes('ROLE') || notif.type.includes('MENTOR') ? 'bg-purple-500/10 border-purple-500/30 text-purple-400' :
                 'bg-slate-700 border-slate-600 text-slate-300' %>">
              <%= notif.type.replace('_', ' ') %>
            </span>
            <div>
              <a href="/notifications/<%= notif.id %>/click" class="text-xs font-semibold text-slate-200 hover:text-indigo-300 transition flex items-center gap-1.5">
                <%= notif.title %>
                <% if (!notif.is_read) { %>
                  <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 inline-block" title="Unread"></span>
                <% } %>
              </a>
              <p class="text-xs text-slate-400 mt-0.5 line-clamp-1"><%= notif.message %></p>
            </div>
          </div>
          <span class="text-[11px] font-mono text-slate-500 flex-shrink-0 self-center">
            <%= new Date(notif.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
          </span>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center py-6 text-slate-400 text-xs">
      No recent activity or notifications.
    </div>
  <% } %>
</div>

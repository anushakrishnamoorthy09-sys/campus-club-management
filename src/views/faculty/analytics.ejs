<div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8 space-y-6">
  <!-- Header -->
  <div class="border-b pb-5 border-slate-200 dark:border-slate-700">
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Faculty Analytics Dashboard</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Overview of pending approval actions, assigned clubs, and mentee engagement metrics.</p>
  </div>

  <!-- Pending Work Queue Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Pending Event Proposals</p>
      <p class="text-3xl font-black text-amber-500 mt-2"><%= metrics.pendingEventsCount %></p>
      <p class="text-xs text-slate-400 mt-1">Requires Faculty Approval</p>
      <a href="/faculty/events/approvals" class="inline-block mt-3 text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline">Go to Event Approvals &rarr;</a>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Pending Mentee OD Requests</p>
      <p class="text-3xl font-black text-indigo-600 dark:text-indigo-400 mt-2"><%= metrics.pendingMenteesODCount %></p>
      <p class="text-xs text-slate-400 mt-1">Requires Mentor Review</p>
      <a href="/faculty/od/approvals" class="inline-block mt-3 text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline">Go to OD Approvals &rarr;</a>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Assigned Mentees</p>
      <p class="text-3xl font-black text-slate-900 dark:text-white mt-2"><%= metrics.menteesSummary.totalMentees %></p>
      <p class="text-xs text-slate-400 mt-1">Under Class Mentorship</p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Mentees Event Attendance</p>
      <p class="text-3xl font-black text-emerald-600 dark:text-emerald-400 mt-2"><%= metrics.menteesSummary.menteeEventsAttended %></p>
      <p class="text-xs text-slate-400 mt-1">Confirmed Present</p>
    </div>
  </div>

  <!-- Assigned Clubs & Mentees Summary -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-700">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">Assigned Club Co-ordinators</h3>
      <% if (!metrics.assignedClubs || metrics.assignedClubs.length === 0) { %>
        <div class="p-6 text-center bg-slate-50 dark:bg-slate-900/50 rounded-lg border border-dashed border-slate-300 dark:border-slate-700">
          <p class="text-slate-500 dark:text-slate-400 text-sm">You are currently not assigned as coordinator for any club.</p>
        </div>
      <% } else { %>
        <ul class="divide-y divide-slate-200 dark:divide-slate-700">
          <% metrics.assignedClubs.forEach(club => { %>
            <li class="py-3 flex justify-between items-center">
              <div>
                <p class="text-sm font-bold text-slate-900 dark:text-white"><%= club.name %></p>
                <p class="text-xs text-slate-500 dark:text-slate-400">Code: <%= club.code %></p>
              </div>
              <a href="/club/analytics?clubId=<%= club.id %>" class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline">
                View Club Analytics &rarr;
              </a>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-700">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">Mentees On-Duty Summary</h3>
      <div class="space-y-4">
        <div class="flex items-center justify-between p-4 bg-slate-50 dark:bg-slate-900/60 rounded-lg">
          <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Total OD Applications Filed</span>
          <span class="text-lg font-extrabold text-indigo-600 dark:text-indigo-400"><%= metrics.menteesSummary.menteeTotalODs %></span>
        </div>
        <div class="flex items-center justify-between p-4 bg-slate-50 dark:bg-slate-900/60 rounded-lg">
          <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Approved Mentee OD Applications</span>
          <span class="text-lg font-extrabold text-emerald-600 dark:text-emerald-400"><%= metrics.menteesSummary.menteeApprovedODs %></span>
        </div>
      </div>
    </div>
  </div>
</div>

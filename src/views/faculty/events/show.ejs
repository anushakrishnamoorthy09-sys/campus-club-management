<div class="space-y-8 max-w-5xl mx-auto">

  <!-- Navigation & Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <a href="/faculty/events" class="text-xs text-indigo-400 hover:underline mb-2 inline-block">&larr; Back to Approvals Queue</a>
      <div class="flex items-center space-x-3">
        <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight"><%= event.title %></h1>
        <!-- Status Pill -->
        <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20"><%= event.status %></span>
      </div>
      <p class="text-sm text-slate-400 mt-1">Organized by <span class="text-slate-200 font-semibold"><%= event.club_name %></span> (<%= event.club_code %>)</p>
    </div>
    <div>
      <a href="/messages/context/EVENT/<%= event.id %>" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-xl shadow-xs transition flex items-center space-x-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 4.418 9 8z"></path></svg>
        <span>Discuss Thread</span>
      </a>
    </div>
  </div>

  <!-- Alerts -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Overview Cards -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Event Details & Impact -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-4">
        <% if (event.banner_url) { %>
          <div class="rounded-xl overflow-hidden max-h-64 border border-slate-700 mb-4">
            <img src="<%= event.banner_url %>" alt="<%= event.title %> Banner" class="w-full h-full object-cover">
          </div>
        <% } %>

        <h2 class="text-base font-bold text-white">Proposal Description</h2>
        <p class="text-sm text-slate-300 whitespace-pre-line leading-relaxed"><%= event.description %></p>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-700/60 text-xs">
          <div>
            <span class="block text-slate-500 font-semibold uppercase">Scheduled Date</span>
            <span class="font-bold text-slate-200 text-sm"><%= event.event_date %></span>
          </div>
          <div>
            <span class="block text-slate-500 font-semibold uppercase">Time Slot</span>
            <span class="font-bold text-slate-200 text-sm"><%= event.start_time %> - <%= event.end_time %></span>
          </div>
          <div>
            <span class="block text-slate-500 font-semibold uppercase">Venue</span>
            <span class="font-bold text-slate-200 text-sm"><%= event.venue %></span>
          </div>
        </div>
      </div>

      <!-- Timetable & Venue Analysis -->
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-3">
        <h2 class="text-base font-bold text-white flex items-center space-x-2">
          <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>Academic Impact & Venue Conflict Analysis</span>
        </h2>

        <div class="p-4 bg-indigo-950/40 border border-indigo-500/20 rounded-xl text-xs space-y-1">
          <% if (!periodImpact.active) { %>
            <p class="text-slate-400"><%= periodImpact.reason === 'NON_WORKING_DAY' ? '✅ Scheduled on a non-working day (No class periods affected).' : 'ℹ️ No active timetable structure on this date.' %></p>
          <% } else if (periodImpact.reason === 'ONLY_BREAKS') { %>
            <p class="text-emerald-400">✅ Event takes place during break hours (No class periods affected).</p>
          <% } else if (periodImpact.periods && periodImpact.periods.length > 0) { %>
            <p class="text-slate-200">
              ⚠️ Overlaps with <strong class="text-white"><%= periodImpact.periods.length %> class period(s)</strong>:
              Periods <%= periodImpact.periods.map(p => `#${p.period_number} (${p.start_time}-${p.end_time})`).join(', ') %>
            </p>
          <% } else { %>
            <p class="text-emerald-400">✅ No class period conflicts detected.</p>
          <% } %>

          <% if (venueConflicts && venueConflicts.length > 0) { %>
            <div class="mt-3 pt-3 border-t border-indigo-500/20 text-amber-300">
              ⚠️ <strong>Venue Conflict Warning:</strong> <%= venueConflicts.length %> overlapping event(s) scheduled at '<%= event.venue %>':
              <%= venueConflicts.map(c => `'${c.title}' (${c.start_time}-${c.end_time})`).join(', ') %>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Coordinator Action Panel -->
    <div class="space-y-6">

      <!-- Creator & Club Stats -->
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-3 text-xs">
        <h3 class="text-sm font-bold text-white">Proposal Metadata</h3>
        <div>
          <span class="text-slate-500 block">Submitted By</span>
          <span class="font-bold text-white text-sm"><%= event.creator_name %></span>
          <span class="text-indigo-400 block"><%= event.creator_email %> (<%= event.creator_role %>)</span>
        </div>
        <div class="pt-2 border-t border-slate-700/60">
          <span class="text-slate-500 block mb-1">Club Approval Track Record</span>
          <div class="flex items-center space-x-2">
            <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-mono border border-emerald-500/20">Approved: <%= clubStats.approved_count || 0 %></span>
            <span class="px-2 py-0.5 rounded bg-rose-500/10 text-rose-400 font-mono border border-rose-500/20">Rejected: <%= clubStats.rejected_count || 0 %></span>
          </div>
        </div>
      </div>

      <!-- Actions Panel -->
      <% if (event.status === 'PENDING_APPROVAL') { %>
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-4">
          <h3 class="text-sm font-bold text-white">Coordinator Decision</h3>

          <% if (event.created_by !== user.id) { %>
            <!-- Approve Form -->
            <form action="/faculty/events/<%= event.id %>/action" method="POST">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <input type="hidden" name="action" value="approve">
              <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl transition shadow-md shadow-emerald-600/30">
                Approve Proposal (Make Visible to Students)
              </button>
            </form>
          <% } else { %>
            <div class="p-3 bg-slate-900 border border-slate-700 rounded-xl text-xs text-slate-400 text-center italic">
              Self-approval protection: You created this event proposal, so you cannot approve it.
            </div>
          <% } %>

          <!-- Reject Form -->
          <form action="/faculty/events/<%= event.id %>/action" method="POST" class="space-y-3 pt-2 border-t border-slate-700/60">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="action" value="reject">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Rejection Remark * (min 3 chars)</label>
              <textarea name="remark" required rows="2" placeholder="Mandatory feedback explaining rejection..." class="w-full px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-white text-xs focus:outline-none focus:border-rose-500"></textarea>
            </div>
            <button type="submit" class="w-full py-2 bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs rounded-lg transition">
              Reject Proposal
            </button>
          </form>

          <!-- Escalate Form -->
          <form action="/faculty/events/<%= event.id %>/action" method="POST" class="space-y-3 pt-2 border-t border-slate-700/60">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="action" value="escalate">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Escalation Reason * (min 3 chars)</label>
              <textarea name="reason" required rows="2" placeholder="Mandatory reason for admin escalation..." class="w-full px-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-white text-xs focus:outline-none focus:border-amber-500"></textarea>
            </div>
            <button type="submit" class="w-full py-2 bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs rounded-lg transition">
              Escalate to Admin
            </button>
          </form>
        </div>
      <% } %>

    </div>
  </div>

  <!-- Full Audit Log Timeline -->
  <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-4">
    <h2 class="text-lg font-bold text-white flex items-center space-x-2">
      <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span>Full Audit & Lifecycle Timeline</span>
    </h2>

    <div class="relative border-l-2 border-slate-700 ml-4 space-y-6 pt-2 pl-6">
      <% if (auditLogs.length === 0) { %>
        <p class="text-xs text-slate-500 italic">No recorded audit log entries.</p>
      <% } %>

      <% auditLogs.forEach(log => { %>
        <% let parsedDetails = {}; try { parsedDetails = JSON.parse(log.details_json || '{}'); } catch(e){} %>
        <div class="relative group">
          <div class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-indigo-500 border-2 border-slate-900"></div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <span class="text-xs font-mono font-bold text-indigo-400"><%= log.action %></span>
            <span class="text-[11px] text-slate-500"><%= log.timestamp %></span>
          </div>

          <p class="text-xs text-slate-300 mt-1">
            Actor: <strong class="text-white"><%= log.actor_name || 'System' %></strong>
            <% if (log.actor_role) { %><span class="text-slate-400 font-mono text-[10px]">(<%= log.actor_role %>)</span><% } %>
          </p>

          <% if (parsedDetails.remark || parsedDetails.reason) { %>
            <p class="text-xs text-amber-300/90 font-mono bg-slate-900/80 p-2.5 rounded-lg border border-slate-700/80 mt-1.5">
              Remark/Reason: <%= parsedDetails.remark || parsedDetails.reason %>
            </p>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>

</div>

<div class="space-y-8">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Faculty Event Approvals Queue</h1>
      <p class="text-sm text-slate-400 mt-1">Review, approve, reject, or escalate event proposals for your assigned coordinated clubs</p>
    </div>
  </div>

  <!-- Alerts -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Coordinated Clubs Summary Bar -->
  <div class="p-4 bg-slate-800/80 border border-slate-700/80 rounded-2xl flex flex-wrap items-center justify-between gap-3 text-xs">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-slate-400 font-semibold uppercase">Your Coordinated Clubs:</span>
      <% if (coordinatedClubs.length === 0) { %>
        <span class="text-amber-400 italic">No assigned club coordinator roles found</span>
      <% } else { %>
        <% coordinatedClubs.forEach(c => { %>
          <span class="px-2.5 py-1 rounded-lg bg-indigo-600/20 text-indigo-300 font-bold border border-indigo-500/30"><%= c.name %> (<%= c.code %>)</span>
        <% }) %>
      <% } %>
    </div>
    <div class="text-slate-400">
      Pending Review: <strong class="text-white font-mono text-sm"><%= pendingEvents.length %></strong> proposals
    </div>
  </div>

  <!-- PENDING APPROVAL QUEUE -->
  <div class="space-y-6">
    <h2 class="text-lg font-bold text-white flex items-center space-x-2">
      <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span>Pending Event Proposals (<%= pendingEvents.length %>)</span>
    </h2>

    <% if (pendingEvents.length === 0) { %>
      <div class="p-8 bg-slate-800/40 border border-slate-700/40 rounded-2xl text-center text-slate-400 text-sm">
        🎉 No event proposals currently pending review for your coordinated clubs.
      </div>
    <% } %>

    <div class="grid grid-cols-1 gap-6">
      <% pendingEvents.forEach(e => { %>
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-4">
          <!-- Card Top Bar -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-700/60 pb-3">
            <div class="flex items-center space-x-3">
              <span class="px-2.5 py-1 rounded-lg bg-indigo-600/20 text-indigo-400 font-mono font-bold text-xs border border-indigo-500/30"><%= e.club_code %></span>
              <h3 class="text-lg font-bold text-white"><%= e.club_name %></h3>
            </div>
            <!-- Club Historical Stats -->
            <div class="flex items-center space-x-2 text-xs">
              <span class="text-slate-400">Club History:</span>
              <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-mono border border-emerald-500/20">Approved: <%= e.clubStats.approved_count || 0 %></span>
              <span class="px-2 py-0.5 rounded bg-rose-500/10 text-rose-400 font-mono border border-rose-500/20">Rejected: <%= e.clubStats.rejected_count || 0 %></span>
            </div>
          </div>

          <!-- Main Info -->
          <div class="space-y-2">
            <h4 class="text-xl font-bold text-white tracking-tight">
              <a href="/faculty/events/<%= e.id %>" class="hover:text-indigo-400 transition"><%= e.title %></a>
            </h4>
            <p class="text-xs text-slate-300 line-clamp-2"><%= e.description %></p>

            <div class="flex flex-wrap items-center gap-3 pt-2 text-xs text-slate-400">
              <span>📅 <strong><%= e.event_date %></strong> (<%= e.start_time %> - <%= e.end_time %>)</span>
              <span>📍 <strong><%= e.venue %></strong></span>
              <span>👥 Max Capacity: <strong><%= e.capacity %></strong></span>
              <span>👤 Creator: <strong><%= e.creator_name %></strong> (<%= e.creator_role %>)</span>
            </div>
          </div>

          <!-- Affected Periods Callout -->
          <div class="p-3 bg-indigo-950/40 border border-indigo-500/20 rounded-xl text-xs space-y-1">
            <strong class="text-indigo-300 font-bold block mb-1">Academic Timetable Impact:</strong>
            <% if (!e.periodImpact.active) { %>
              <span class="text-slate-400"><%= e.periodImpact.reason === 'NON_WORKING_DAY' ? '✅ Scheduled on a non-working day (No class periods affected).' : 'ℹ️ No active timetable structure on this date.' %></span>
            <% } else if (e.periodImpact.reason === 'ONLY_BREAKS') { %>
              <span class="text-emerald-400">✅ Event takes place during break hours (No class periods affected).</span>
            <% } else if (e.periodImpact.periods && e.periodImpact.periods.length > 0) { %>
              <span class="text-slate-200">
                ⚠️ Overlaps with <strong class="text-white"><%= e.periodImpact.periods.length %> class period(s)</strong>:
                Periods <%= e.periodImpact.periods.map(p => `#${p.period_number} (${p.start_time}-${p.end_time})`).join(', ') %>
              </span>
            <% } else { %>
              <span class="text-emerald-400">✅ No class period conflicts detected.</span>
            <% } %>

            <!-- Venue Conflict Warning -->
            <% if (e.venueConflicts && e.venueConflicts.length > 0) { %>
              <div class="mt-2 pt-2 border-t border-indigo-500/20 text-amber-300">
                ⚠️ <strong>Venue Conflict Warning:</strong> <%= e.venueConflicts.length %> overlapping event(s) scheduled at '<%= e.venue %>':
                <%= e.venueConflicts.map(c => `'${c.title}' (${c.start_time}-${c.end_time})`).join(', ') %>
              </div>
            <% } %>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-slate-700/60">
            <a href="/faculty/events/<%= e.id %>" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white font-semibold text-xs rounded-xl transition border border-slate-600">
              View Full Audit Log & Details &rarr;
            </a>

            <div class="flex items-center space-x-2">
              <!-- Approve Button (if not self-created) -->
              <% if (e.created_by !== user.id) { %>
                <form action="/faculty/events/<%= e.id %>/action" method="POST" class="inline">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                  <input type="hidden" name="action" value="approve">
                  <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl transition shadow-md shadow-emerald-600/30">
                    Approve Event
                  </button>
                </form>
              <% } else { %>
                <span class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-500 text-xs italic border border-slate-700">Self-Approval Blocked</span>
              <% } %>

              <!-- Reject Form Modal/Details -->
              <details class="relative">
                <summary class="cursor-pointer px-4 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 font-bold text-xs rounded-xl border border-rose-500/30 transition">
                  Reject...
                </summary>
                <div class="absolute right-0 mt-2 w-80 bg-slate-900 border border-slate-700 rounded-2xl p-4 shadow-2xl z-20 text-left">
                  <h5 class="text-sm font-bold text-white mb-2">Reject Event Proposal</h5>
                  <form action="/faculty/events/<%= e.id %>/action" method="POST" class="space-y-3">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <input type="hidden" name="action" value="reject">
                    <div>
                      <label class="block text-xs text-slate-400 mb-1">Rejection Remark * (min 3 chars)</label>
                      <textarea name="remark" required rows="3" placeholder="Provide feedback for the club..." class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs"></textarea>
                    </div>
                    <button type="submit" class="w-full py-2 bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs rounded-lg transition">Confirm Rejection</button>
                  </form>
                </div>
              </details>

              <!-- Escalate Form Modal/Details -->
              <details class="relative">
                <summary class="cursor-pointer px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 font-bold text-xs rounded-xl border border-amber-500/30 transition">
                  Escalate...
                </summary>
                <div class="absolute right-0 mt-2 w-80 bg-slate-900 border border-slate-700 rounded-2xl p-4 shadow-2xl z-20 text-left">
                  <h5 class="text-sm font-bold text-white mb-2">Escalate to Institutional Admin</h5>
                  <form action="/faculty/events/<%= e.id %>/action" method="POST" class="space-y-3">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <input type="hidden" name="action" value="escalate">
                    <div>
                      <label class="block text-xs text-slate-400 mb-1">Escalation Reason * (min 3 chars)</label>
                      <textarea name="reason" required rows="3" placeholder="Explain why admin decision is required..." class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs"></textarea>
                    </div>
                    <button type="submit" class="w-full py-2 bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs rounded-lg transition">Escalate Proposal</button>
                  </form>
                </div>
              </details>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- DECISIONS HISTORY TAB -->
  <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-4">
    <h2 class="text-lg font-bold text-white flex items-center space-x-2">
      <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
      <span>Decisions History Log (<%= decisionHistory.length %> Entries)</span>
    </h2>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-900/80 text-slate-400 uppercase tracking-wider border-b border-slate-700">
            <th class="py-3 px-4">Timestamp</th>
            <th class="py-3 px-4">Event & Club</th>
            <th class="py-3 px-4">Decision Outcome</th>
            <th class="py-3 px-4">Actor</th>
            <th class="py-3 px-4">Remark / Reason</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-700/60 text-slate-300">
          <% if (decisionHistory.length === 0) { %>
            <tr>
              <td colspan="5" class="py-6 text-center text-slate-500 italic">No past decision history recorded yet.</td>
            </tr>
          <% } %>

          <% decisionHistory.forEach(log => { %>
            <% let details = {}; try { details = JSON.parse(log.details_json || '{}'); } catch(e){} %>
            <tr class="hover:bg-slate-800/40 transition">
              <td class="py-3 px-4 text-slate-400 font-mono"><%= log.timestamp %></td>
              <td class="py-3 px-4 font-semibold text-white">
                <%= log.event_title %> <span class="text-slate-400 font-normal">(<%= log.club_name %>)</span>
              </td>
              <td class="py-3 px-4 font-mono font-bold">
                <% if (log.action.includes('APPROVED')) { %>
                  <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"><%= log.action %></span>
                <% } else if (log.action.includes('REJECTED')) { %>
                  <span class="px-2 py-0.5 rounded bg-rose-500/10 text-rose-400 border border-rose-500/20"><%= log.action %></span>
                <% } else { %>
                  <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20"><%= log.action %></span>
                <% } %>
              </td>
              <td class="py-3 px-4 font-semibold text-slate-200"><%= log.actor_name || 'System' %></td>
              <td class="py-3 px-4 font-mono text-slate-400"><%= details.remark || details.reason || 'N/A' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

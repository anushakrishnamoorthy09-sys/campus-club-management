<div class="space-y-8">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Institutional On-Duty (OD) Oversight</h1>
      <p class="text-sm text-slate-400 mt-1">Review escalated OD applications and inspect global campus OD records</p>
    </div>
    <div class="flex items-center space-x-2">
      <a href="/admin/mentor-reassignment" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl transition shadow shadow-indigo-600/30">
        Reassign Class Mentor &rarr;
      </a>
    </div>
  </div>

  <!-- Alerts -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-start space-x-2">
      <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <div>
        <strong class="font-bold block">Action Denied</strong>
        <span><%= error %></span>
      </div>
    </div>
  <% } %>

  <!-- Tab Controls -->
  <div class="flex border-b border-slate-700/60 space-x-4 text-sm font-semibold">
    <a href="/admin/od?tab=escalated" class="pb-3 border-b-2 transition <%= activeTab !== 'global' ? 'border-indigo-500 text-white font-bold' : 'border-transparent text-slate-400 hover:text-slate-200' %>">
      Escalated Queue (<%= escalatedQueue.length %>)
    </a>
    <a href="/admin/od?tab=global" class="pb-3 border-b-2 transition <%= activeTab === 'global' ? 'border-indigo-500 text-white font-bold' : 'border-transparent text-slate-400 hover:text-slate-200' %>">
      Global OD Directory (<%= globalODs.length %>)
    </a>
  </div>

  <% if (activeTab !== 'global') { %>
    <!-- ESCALATED QUEUE FOR ADMIN DECISION -->
    <div class="grid grid-cols-1 gap-6">
      <% if (escalatedQueue.length === 0) { %>
        <div class="p-8 bg-slate-800/40 border border-slate-700/40 rounded-2xl text-center text-slate-400 text-sm">
          🎉 No escalated OD requests currently requiring Administrator review.
        </div>
      <% } %>

      <% escalatedQueue.forEach(od => { %>
        <div class="bg-slate-800/60 border border-amber-500/30 rounded-2xl p-6 shadow-xl flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          
          <div class="space-y-4 max-w-3xl flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 animate-pulse">ESCALATED TO ADMIN</span>
              <span class="text-xs text-slate-400 font-mono">Escalated on: <strong><%= od.escalated_at %></strong></span>
              <span class="text-xs text-indigo-400 font-mono font-bold"><%= od.club_name %></span>
            </div>

            <div>
              <h3 class="text-lg font-bold text-white tracking-tight">
                <%= od.student_name %> <span class="text-xs text-slate-400 font-mono font-normal">(RA: <%= od.ra_number %>)</span>
              </h3>
              <div class="text-xs text-slate-400">
                Mentored by: <strong class="text-slate-200"><%= od.mentor_name %></strong> | <%= od.department %> (<%= od.year_of_study %> Year)
              </div>
            </div>

            <div class="p-4 bg-slate-900/60 rounded-xl border border-slate-700/60 space-y-2">
              <div class="text-xs font-bold text-white">Event: <%= od.event_title %></div>
              <div class="text-xs text-slate-400">📅 Date: <%= od.event_date %> (<%= formatTime12h(od.start_time) %> - <%= formatTime12h(od.end_time) %>) | 📍 <%= od.event_venue %></div>
              <div class="text-xs text-indigo-300 font-mono font-bold pt-1">⏰ Missed Periods: <%= formatPeriodSummary(od.periods) %></div>

              <!-- Escalation Reason -->
              <div class="p-2.5 bg-amber-500/10 border border-amber-500/20 rounded-lg text-xs text-amber-300 mt-2">
                <strong>Mentor Escalation Reason:</strong> "<%= od.escalation_reason %>"
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row lg:flex-col items-stretch lg:items-end gap-2.5 min-w-[220px] flex-shrink-0">
            <a href="/admin/od/<%= od.id %>" class="w-full px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl transition text-center shadow shadow-indigo-600/30">
              Review & Resolve &rarr;
            </a>
          </div>

        </div>
      <% }) %>
    </div>
  <% } else { %>
    <!-- GLOBAL READ-ONLY OVERVIEW WITH FILTERS -->
    <div class="space-y-6">
      
      <!-- Filter Form -->
      <form action="/admin/od" method="GET" class="p-4 bg-slate-800/60 border border-slate-700/60 rounded-2xl grid grid-cols-1 sm:grid-cols-4 gap-4 text-xs">
        <input type="hidden" name="tab" value="global">
        <div>
          <label class="block text-slate-400 font-bold uppercase font-mono mb-1">Status Filter</label>
          <select name="status" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white">
            <option value="">All Statuses</option>
            <option value="PENDING" <%= selectedStatus === 'PENDING' ? 'selected' : '' %>>PENDING</option>
            <option value="APPROVED" <%= selectedStatus === 'APPROVED' ? 'selected' : '' %>>APPROVED</option>
            <option value="REJECTED" <%= selectedStatus === 'REJECTED' ? 'selected' : '' %>>REJECTED</option>
            <option value="CLOSED" <%= selectedStatus === 'CLOSED' ? 'selected' : '' %>>CLOSED</option>
          </select>
        </div>

        <div>
          <label class="block text-slate-400 font-bold uppercase font-mono mb-1">Student RA</label>
          <input type="text" name="searchRa" value="<%= searchRa %>" placeholder="e.g. RA2311003010001" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white">
        </div>

        <div>
          <label class="block text-slate-400 font-bold uppercase font-mono mb-1">Event Date</label>
          <input type="date" name="date" value="<%= dateFilter %>" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-white">
        </div>

        <div class="flex items-end space-x-2">
          <button type="submit" class="w-full px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl transition">Filter</button>
          <a href="/admin/od?tab=global" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-300 font-semibold rounded-xl text-center">Reset</a>
        </div>
      </form>

      <!-- Global Roster Table -->
      <div class="overflow-x-auto rounded-xl border border-slate-700/60">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-900/80 text-slate-400 uppercase font-mono font-bold border-b border-slate-700/60">
            <tr>
              <th class="py-3 px-4">OD ID</th>
              <th class="py-3 px-4">Student</th>
              <th class="py-3 px-4">RA Number</th>
              <th class="py-3 px-4">Event & Club</th>
              <th class="py-3 px-4">Periods Covered</th>
              <th class="py-3 px-4">Status</th>
              <th class="py-3 px-4">Decision Via</th>
              <th class="py-3 px-4 text-right">Detail</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-700/40">
            <% globalODs.forEach(od => { %>
              <tr class="hover:bg-slate-700/20 transition">
                <td class="py-3 px-4 font-mono font-bold text-indigo-400">#<%= od.id %></td>
                <td class="py-3 px-4 font-bold text-white"><%= od.student_name %></td>
                <td class="py-3 px-4 font-mono text-slate-300"><%= od.ra_number %></td>
                <td class="py-3 px-4">
                  <div class="font-semibold text-white"><%= od.event_title %></div>
                  <div class="text-[10px] text-indigo-400 font-mono"><%= od.club_name %></div>
                </td>
                <td class="py-3 px-4 font-mono text-slate-300"><%= formatPeriodSummary(od.periods) %></td>
                <td class="py-3 px-4 font-bold">
                  <span class="<%= od.status === 'APPROVED' ? 'text-emerald-400' : (od.status === 'REJECTED' ? 'text-rose-400' : (od.status === 'CLOSED' ? 'text-slate-400' : 'text-amber-400')) %>"><%= od.status %></span>
                  <% if (od.status === 'APPROVED' && od.attendance_status === 'ABSENT') { %>
                    <div class="mt-1"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/40 animate-pulse">⚠️ APPROVED BUT ABSENT</span></div>
                  <% } %>
                </td>
                <td class="py-3 px-4 font-mono text-[11px] text-slate-400"><%= od.decided_via || (od.escalated_at ? 'ESCALATED' : 'PENDING') %></td>
                <td class="py-3 px-4 text-right">
                  <a href="/admin/od/<%= od.id %>" class="px-2.5 py-1 bg-slate-700 hover:bg-slate-600 text-white font-bold text-[11px] rounded-lg transition inline-block">
                    View
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    </div>
  <% } %>

</div>

<div class="space-y-8">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Institutional Event Governance</h1>
      <p class="text-sm text-slate-400 mt-1">Manage escalated proposals, inspect pending wait times, filter institutional events, and issue Super Admin overrides</p>
    </div>
  </div>

  <!-- Alerts -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- 1. ESCALATED EVENTS QUEUE -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-white flex items-center space-x-2">
        <svg class="w-5 h-5 text-rose-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        <span>Escalated Events Queue (<%= escalatedEvents.length %>)</span>
      </h2>
    </div>

    <% if (escalatedEvents.length === 0) { %>
      <div class="p-6 bg-slate-800/40 border border-slate-700/40 rounded-2xl text-center text-slate-400 text-sm">
        ✅ No escalated event proposals currently require administrative resolution.
      </div>
    <% } %>

    <div class="grid grid-cols-1 gap-4">
      <% escalatedEvents.forEach(e => { %>
        <div class="bg-slate-800/60 border border-rose-500/30 rounded-2xl p-6 shadow-xl space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-700/60 pb-3">
            <div class="flex items-center space-x-3">
              <span class="px-2.5 py-1 rounded-lg bg-rose-500/20 text-rose-300 font-mono font-bold text-xs border border-rose-500/30">ESCALATED</span>
              <h3 class="text-lg font-bold text-white"><%= e.title %></h3>
              <span class="text-xs text-slate-400">(<%= e.club_name %> - <%= e.club_code %>)</span>
            </div>
            <span class="text-xs font-mono text-amber-400">Escalated <%= e.waitTime %></span>
          </div>

          <div class="space-y-2">
            <p class="text-xs text-slate-300 line-clamp-2"><%= e.description %></p>
            <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400">
              <span>📅 <strong><%= e.event_date %></strong> (<%= e.start_time %> - <%= e.end_time %>)</span>
              <span>📍 <strong><%= e.venue %></strong></span>
              <span>👥 Capacity: <strong><%= e.capacity %></strong></span>
              <span>👤 Escalated By: <strong class="text-white"><%= e.escalator_name || 'Faculty Coordinator' %></strong></span>
            </div>

            <!-- Escalation Reason Callout -->
            <div class="p-3 bg-rose-950/40 border border-rose-500/30 rounded-xl text-xs text-rose-300">
              <strong class="font-semibold text-rose-200">Escalation Reason:</strong> <%= e.escalation_reason || 'Referred to admin for institutional review' %>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-slate-700/60">
            <a href="/admin/events/<%= e.id %>" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white font-semibold text-xs rounded-xl transition border border-slate-600">
              View Audit History & Details &rarr;
            </a>

            <div class="flex items-center space-x-2">
              <% if (e.created_by !== user.id) { %>
                <!-- Escalation Approve Form -->
                <details class="relative">
                  <summary class="cursor-pointer px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl transition shadow-md shadow-emerald-600/30">
                    Approve Escalation...
                  </summary>
                  <div class="absolute right-0 mt-2 w-80 bg-slate-900 border border-slate-700 rounded-2xl p-4 shadow-2xl z-20 text-left">
                    <h5 class="text-sm font-bold text-white mb-2">Approve Escalated Event</h5>
                    <form action="/admin/events/<%= e.id %>/action" method="POST" class="space-y-3">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                      <input type="hidden" name="action" value="escalation-approve">
                      <div>
                        <label class="block text-xs text-slate-400 mb-1">Decision Reason * (min 3 chars)</label>
                        <textarea name="reason" required rows="2" placeholder="Reason for approving escalated proposal..." class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs"></textarea>
                      </div>
                      <button type="submit" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-lg transition">Approve Escalated Proposal</button>
                    </form>
                  </div>
                </details>

                <!-- Escalation Reject Form -->
                <details class="relative">
                  <summary class="cursor-pointer px-4 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 font-bold text-xs rounded-xl border border-rose-500/30 transition">
                    Reject Escalation...
                  </summary>
                  <div class="absolute right-0 mt-2 w-80 bg-slate-900 border border-slate-700 rounded-2xl p-4 shadow-2xl z-20 text-left">
                    <h5 class="text-sm font-bold text-white mb-2">Reject Escalated Event</h5>
                    <form action="/admin/events/<%= e.id %>/action" method="POST" class="space-y-3">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                      <input type="hidden" name="action" value="escalation-reject">
                      <div>
                        <label class="block text-xs text-slate-400 mb-1">Rejection Remark * (min 3 chars)</label>
                        <textarea name="remark" required rows="2" placeholder="Rejection remark for the club..." class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs"></textarea>
                      </div>
                      <button type="submit" class="w-full py-2 bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs rounded-lg transition">Reject Escalated Proposal</button>
                    </form>
                  </div>
                </details>
              <% } else { %>
                <span class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-500 text-xs italic border border-slate-700">Creator Decision Blocked</span>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- 2. PENDING APPROVAL OVERVIEW (Wait Time Tracking) -->
  <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-4">
    <h2 class="text-lg font-bold text-white flex items-center space-x-2">
      <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span>Pending Proposals Wait Time Tracker (<%= pendingOverview.length %> Pending)</span>
    </h2>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-900/80 text-slate-400 uppercase tracking-wider border-b border-slate-700">
            <th class="py-3 px-4">Event Title</th>
            <th class="py-3 px-4">Club</th>
            <th class="py-3 px-4">Submitted By</th>
            <th class="py-3 px-4">Wait Duration</th>
            <th class="py-3 px-4">Escalation Status</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-700/60 text-slate-300">
          <% if (pendingOverview.length === 0) { %>
            <tr>
              <td colspan="6" class="py-6 text-center text-slate-500 italic">No proposals currently pending approval.</td>
            </tr>
          <% } %>

          <% pendingOverview.forEach(p => { %>
            <tr class="hover:bg-slate-800/40 transition">
              <td class="py-3.5 px-4 font-bold text-white">
                <a href="/admin/events/<%= p.id %>" class="hover:text-indigo-400 transition"><%= p.title %></a>
              </td>
              <td class="py-3.5 px-4"><%= p.club_name %> (<%= p.club_code %>)</td>
              <td class="py-3.5 px-4"><%= p.creator_name %></td>
              <td class="py-3.5 px-4 font-mono font-semibold text-amber-400"><%= p.waitTime %></td>
              <td class="py-3.5 px-4 font-mono">
                <% if (p.escalated_at) { %>
                  <span class="px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 text-[10px] font-bold">ESCALATED</span>
                <% } else { %>
                  <span class="text-slate-500">Normal Review</span>
                <% } %>
              </td>
              <td class="py-3.5 px-4 text-right">
                <a href="/admin/events/<%= p.id %>" class="px-3 py-1 bg-slate-700 hover:bg-slate-600 text-white font-semibold text-[11px] rounded-lg border border-slate-600 transition">
                  Inspect & Governance
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 3. ALL EVENTS EXPLORER WITH FILTERS -->
  <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-700/60">
      <h2 class="text-lg font-bold text-white">Institutional Events Catalog Explorer</h2>
    </div>

    <!-- Filters Form -->
    <form action="/admin/events" method="GET" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 p-4 bg-slate-900/80 border border-slate-700/80 rounded-xl">
      <div>
        <label class="block text-xs font-semibold text-slate-400 mb-1">Filter by Club</label>
        <select name="clubId" class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs">
          <option value="">All Clubs</option>
          <% clubs.forEach(c => { %>
            <option value="<%= c.id %>" <%= selectedClubId === c.id ? 'selected' : '' %>><%= c.name %> (<%= c.code %>)</option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 mb-1">Filter by Status</label>
        <select name="status" class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs">
          <% const statuses = ['ALL', 'DRAFT', 'PENDING_APPROVAL', 'APPROVED', 'REJECTED', 'ONGOING', 'COMPLETED', 'CANCELLED']; %>
          <% statuses.forEach(s => { %>
            <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s.replace('_', ' ') %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 mb-1">Start Date</label>
        <input type="date" name="startDate" value="<%= startDate %>" class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 mb-1">End Date</label>
        <input type="date" name="endDate" value="<%= endDate %>" class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs">
      </div>

      <div class="sm:col-span-2 md:col-span-4 flex justify-end space-x-2 pt-2">
        <a href="/admin/events" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs rounded-lg transition">Reset Filters</a>
        <button type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-lg transition shadow-md shadow-indigo-600/30">Apply Filters</button>
      </div>
    </form>

    <!-- Events List Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="bg-slate-900/80 text-slate-400 uppercase tracking-wider border-b border-slate-700">
            <th class="py-3.5 px-4 font-semibold">Event Title</th>
            <th class="py-3.5 px-4 font-semibold">Club</th>
            <th class="py-3.5 px-4 font-semibold">Status</th>
            <th class="py-3.5 px-4 font-semibold">Date & Time</th>
            <th class="py-3.5 px-4 font-semibold">Venue</th>
            <th class="py-3.5 px-4 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-700/60 text-slate-300">
          <% if (allEvents.length === 0) { %>
            <tr>
              <td colspan="6" class="py-8 text-center text-slate-500 italic">No events found matching the specified filter criteria.</td>
            </tr>
          <% } %>

          <% allEvents.forEach(e => { %>
            <tr class="hover:bg-slate-800/40 transition">
              <td class="py-3.5 px-4 font-bold text-white">
                <a href="/admin/events/<%= e.id %>" class="hover:text-indigo-400 transition"><%= e.title %></a>
              </td>
              <td class="py-3.5 px-4"><%= e.club_name %> (<%= e.club_code %>)</td>
              <td class="py-3.5 px-4 font-mono font-bold">
                <% if (e.status === 'APPROVED') { %>
                  <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">APPROVED</span>
                <% } else if (e.status === 'PENDING_APPROVAL') { %>
                  <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">PENDING</span>
                <% } else if (e.status === 'REJECTED') { %>
                  <span class="px-2 py-0.5 rounded bg-rose-500/10 text-rose-400 border border-rose-500/20">REJECTED</span>
                <% } else if (e.status === 'ONGOING') { %>
                  <span class="px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">ONGOING</span>
                <% } else { %>
                  <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700"><%= e.status %></span>
                <% } %>
              </td>
              <td class="py-3.5 px-4"><%= e.event_date %> (<%= e.start_time %>)</td>
              <td class="py-3.5 px-4"><%= e.venue %></td>
              <td class="py-3.5 px-4 text-right">
                <a href="/admin/events/<%= e.id %>" class="px-3 py-1 bg-slate-700 hover:bg-slate-600 text-white font-semibold text-[11px] rounded-lg border border-slate-600 transition">
                  Details & Governance
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

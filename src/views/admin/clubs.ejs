<div class="space-y-8">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Campus Club Directory & Management</h1>
      <p class="text-sm text-slate-400 mt-1">Institutional Student Clubs, Personnel Assignment, and Archival Controls</p>
    </div>
  </div>

  <!-- Alerts -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-center space-x-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Create Club Form Card (SUPER_ADMIN ONLY) -->
  <% if (user.role === 'SUPER_ADMIN') { %>
    <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl">
      <h2 class="text-lg font-bold text-white mb-4 flex items-center space-x-2">
        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
        <span>Establish New Campus Club</span>
      </h2>

      <form action="/admin/clubs" method="POST" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Club Name *</label>
            <input type="text" id="name" name="name" required placeholder="e.g. Coding Club" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition">
          </div>

          <div>
            <label for="code" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Unique Code *</label>
            <input type="text" id="code" name="code" required placeholder="e.g. CODING" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition font-mono uppercase">
          </div>

          <div>
            <label for="category" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Category *</label>
            <input type="text" id="category" name="category" required placeholder="e.g. Technical / Cultural" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition">
          </div>
        </div>

        <div>
          <label for="description" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Club Description *</label>
          <textarea id="description" name="description" required rows="2" placeholder="Official description of the club mandate and activities..." class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition"></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="clubAdminId" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Assigned Club Admin * (One Club per Admin)</label>
            <select id="clubAdminId" name="clubAdminId" required class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition">
              <option value="" disabled selected>Select Club Admin</option>
              <% clubAdmins.forEach(ca => { %>
                <option value="<%= ca.id %>" <%= ca.assigned_club_name ? 'disabled' : '' %>>
                  <%= ca.full_name %> (<%= ca.email %>) <%= ca.assigned_club_name ? '• Assigned to ' + ca.assigned_club_name : '• Available' %>
                </option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="facultyCoordinatorIds" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Assigned Faculty Coordinator *</label>
            <select id="facultyCoordinatorIds" name="facultyCoordinatorIds" required class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 transition">
              <option value="" disabled selected>Select Faculty Coordinator</option>
              <% facultyMentors.forEach(fm => { %>
                <option value="<%= fm.faculty_user_id %>">
                  <%= fm.full_name %> (<%= fm.department %> - <%= fm.designation %>)
                </option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="pt-2">
          <button type="submit" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm rounded-xl transition shadow-md shadow-indigo-600/30">
            Establish Club
          </button>
        </div>
      </form>
    </div>
  <% } %>

  <!-- Clubs List Directory -->
  <div class="grid grid-cols-1 gap-6">
    <% clubs.forEach(c => { %>
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="space-y-3 max-w-2xl">
          <div class="flex items-center space-x-3">
            <span class="px-3 py-1 rounded-lg bg-indigo-600/20 text-indigo-400 font-mono font-bold text-xs border border-indigo-500/30"><%= c.code %></span>
            <h3 class="text-xl font-bold text-white tracking-tight"><%= c.name %></h3>
            
            <% if (c.status === 'ACTIVE') { %>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">ACTIVE</span>
            <% } else if (c.status === 'INACTIVE') { %>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">INACTIVE</span>
            <% } else { %>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20">ARCHIVED</span>
            <% } %>
          </div>

          <p class="text-slate-300 text-sm"><%= c.description %></p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-400">
            <div>
              <span class="text-slate-500 font-semibold">Club Admin:</span> 
              <span class="text-white font-medium"><%= c.club_admin_name || 'Unassigned' %></span>
            </div>
            <div>
              <span class="text-slate-500 font-semibold">Coordinators:</span> 
              <span class="text-indigo-400 font-medium">
                <%= c.coordinators && c.coordinators.length > 0 ? c.coordinators.map(coord => coord.full_name).join(', ') : 'None' %>
              </span>
            </div>
          </div>
        </div>

        <!-- Management Forms & Modals -->
        <div class="flex flex-col sm:flex-row md:flex-col lg:flex-row gap-3">
          
          <!-- Edit / Status Form -->
          <details class="relative">
            <summary class="cursor-pointer px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold rounded-xl border border-slate-600 transition text-center">
              Edit Details / Status
            </summary>
            <div class="absolute right-0 mt-2 w-80 bg-slate-900 border border-slate-700 rounded-2xl p-4 shadow-2xl z-20 text-left">
              <h4 class="text-sm font-bold text-white mb-3">Update Club Details</h4>
              <form action="/admin/clubs/<%= c.id %>/update" method="POST" class="space-y-3">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div>
                  <label class="block text-xs text-slate-400 mb-1">Club Name</label>
                  <input type="text" name="name" value="<%= c.name %>" required class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs">
                </div>
                <div>
                  <label class="block text-xs text-slate-400 mb-1">Category</label>
                  <input type="text" name="category" value="<%= c.category %>" required class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs">
                </div>
                <div>
                  <label class="block text-xs text-slate-400 mb-1">Description</label>
                  <textarea name="description" required rows="2" class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs"><%= c.description %></textarea>
                </div>
                <div>
                  <label class="block text-xs text-slate-400 mb-1">Status</label>
                  <select name="status" class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs">
                    <option value="ACTIVE" <%= c.status === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
                    <option value="INACTIVE" <%= c.status === 'INACTIVE' ? 'selected' : '' %>>INACTIVE</option>
                    <option value="ARCHIVED" <%= c.status === 'ARCHIVED' ? 'selected' : '' %>>ARCHIVED</option>
                  </select>
                </div>
                <button type="submit" class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs rounded-lg transition">Save Changes</button>
              </form>
            </div>
          </details>

          <!-- Reassign Personnel Form -->
          <details class="relative">
            <summary class="cursor-pointer px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold rounded-xl border border-slate-600 transition text-center">
              Reassign Personnel
            </summary>
            <div class="absolute right-0 mt-2 w-80 bg-slate-900 border border-slate-700 rounded-2xl p-4 shadow-2xl z-20 text-left">
              <h4 class="text-sm font-bold text-white mb-3">Reassign Club Personnel</h4>
              <form action="/admin/clubs/<%= c.id %>/assign" method="POST" class="space-y-3">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div>
                  <label class="block text-xs text-slate-400 mb-1">Club Admin</label>
                  <select name="clubAdminId" required class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs">
                    <% clubAdmins.forEach(ca => { %>
                      <option value="<%= ca.id %>" <%= ca.id === c.club_admin_id ? 'selected' : '' %>>
                        <%= ca.full_name %>
                      </option>
                    <% }) %>
                  </select>
                </div>
                <div>
                  <label class="block text-xs text-slate-400 mb-1">Faculty Coordinator</label>
                  <select name="facultyCoordinatorIds" required class="w-full px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs">
                    <% facultyMentors.forEach(fm => { %>
                      <option value="<%= fm.faculty_user_id %>" <%= c.coordinators.some(coord => coord.faculty_user_id === fm.faculty_user_id) ? 'selected' : '' %>>
                        <%= fm.full_name %>
                      </option>
                    <% }) %>
                  </select>
                </div>
                <button type="submit" class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs rounded-lg transition">Reassign</button>
              </form>
            </div>
          </details>

          <!-- Delete Club (SUPER_ADMIN ONLY) -->
          <% if (user.role === 'SUPER_ADMIN') { %>
            <form action="/admin/clubs/<%= c.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this campus club? All memberships and data will be removed.');">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="w-full px-4 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 text-xs font-semibold rounded-xl border border-rose-500/20 transition">
                Delete Club
              </button>
            </form>
          <% } %>

        </div>

      </div>
    <% }) %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8 space-y-6">
  <!-- Header -->
  <div class="border-b pb-5 border-slate-200 dark:border-slate-700">
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Institution Analytics & Cross-Club Comparison</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Cross-club participation performance, pending approval queues, and institutional trend charts.</p>
  </div>

  <!-- Pending Queue & Waiting Times Bar -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700 border-l-4 border-l-amber-500">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Pending Event Approvals</p>
      <div class="flex items-baseline justify-between mt-2">
        <p class="text-3xl font-black text-amber-500"><%= metrics.pendingQueue.pendingEventsCount %></p>
        <span class="text-xs font-semibold bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300 px-2 py-0.5 rounded">
          Oldest: <%= metrics.pendingQueue.oldestPendingEventWait %>
        </span>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700 border-l-4 border-l-red-500">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Escalated Events</p>
      <div class="flex items-baseline justify-between mt-2">
        <p class="text-3xl font-black text-red-600 dark:text-red-400"><%= metrics.pendingQueue.escalatedEventsCount %></p>
        <span class="text-xs font-semibold bg-red-100 dark:bg-red-900/40 text-red-800 dark:text-red-300 px-2 py-0.5 rounded">
          Oldest: <%= metrics.pendingQueue.oldestEscalatedEventWait %>
        </span>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700 border-l-4 border-l-purple-500">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Escalated OD Requests</p>
      <div class="flex items-baseline justify-between mt-2">
        <p class="text-3xl font-black text-purple-600 dark:text-purple-400"><%= metrics.pendingQueue.escalatedODsCount %></p>
        <span class="text-xs font-semibold bg-purple-100 dark:bg-purple-900/40 text-purple-800 dark:text-purple-300 px-2 py-0.5 rounded">
          Oldest: <%= metrics.pendingQueue.oldestEscalatedODWait %>
        </span>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl p-5 shadow-sm border border-slate-200 dark:border-slate-700 border-l-4 border-l-emerald-500">
      <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Overall OD Approval Rate</p>
      <div class="flex items-baseline justify-between mt-2">
        <p class="text-3xl font-black text-emerald-600 dark:text-emerald-400"><%= metrics.overallOD.approvalRate %>%</p>
        <span class="text-xs text-slate-400">
          <%= metrics.overallOD.approved %> / <%= metrics.overallOD.decided %> decided
        </span>
      </div>
    </div>
  </div>

  <!-- Monthly Event Trend Chart -->
  <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-700">
    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">Events Volume Trend Per Month</h3>
    <% if (!metrics.eventsPerMonth || metrics.eventsPerMonth.length === 0) { %>
      <div class="p-8 text-center bg-slate-50 dark:bg-slate-900 rounded-lg border border-dashed border-slate-300 dark:border-slate-700">
        <p class="text-slate-500 dark:text-slate-400 font-medium">No event history recorded yet across campus.</p>
      </div>
    <% } else { %>
      <div class="h-64 relative">
        <canvas id="monthlyTrendChart"></canvas>
      </div>
    <% } %>
  </div>

  <!-- Cross-Club Comparison Table -->
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="p-6 border-b border-slate-200 dark:border-slate-700 flex justify-between items-center">
      <div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Cross-Club Performance Ranking</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">Ranked by Activity Score = (Completed Events &times; 10) + Total Registrations</p>
      </div>
    </div>

    <% if (!metrics.clubsComparison || metrics.clubsComparison.length === 0) { %>
      <div class="p-8 text-center text-slate-500 dark:text-slate-400">No clubs registered.</div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-50 dark:bg-slate-900/60 text-slate-500 dark:text-slate-400 uppercase text-xs tracking-wider border-b border-slate-200 dark:border-slate-700">
              <th class="py-3 px-6">Rank</th>
              <th class="py-3 px-6">Club Name & Code</th>
              <th class="py-3 px-6 text-center">Approved Members</th>
              <th class="py-3 px-6 text-center">Completed Events</th>
              <th class="py-3 px-6 text-center">Registrations</th>
              <th class="py-3 px-6 text-center">Avg Turnout %</th>
              <th class="py-3 px-6 text-center">Activity Score</th>
              <th class="py-3 px-6 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-700 font-medium">
            <% metrics.clubsComparison.forEach((club, index) => { %>
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-700/30 transition-colors">
                <td class="py-4 px-6 text-slate-400 font-bold">#<%= index + 1 %></td>
                <td class="py-4 px-6">
                  <div class="font-bold text-slate-900 dark:text-white"><%= club.name %></div>
                  <div class="text-xs font-mono text-slate-500"><%= club.code %></div>
                </td>
                <td class="py-4 px-6 text-center text-slate-700 dark:text-slate-300"><%= club.member_count %></td>
                <td class="py-4 px-6 text-center text-indigo-600 dark:text-indigo-400 font-bold"><%= club.completed_events %></td>
                <td class="py-4 px-6 text-center text-emerald-600 dark:text-emerald-400 font-bold"><%= club.total_registrations %></td>
                <td class="py-4 px-6 text-center text-amber-500 font-bold"><%= club.avg_attendance_rate %>%</td>
                <td class="py-4 px-6 text-center">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-black bg-indigo-100 text-indigo-800 dark:bg-indigo-900/50 dark:text-indigo-300">
                    <%= club.activity_score %> pts
                  </span>
                </td>
                <td class="py-4 px-6 text-right">
                  <a href="/club/analytics?clubId=<%= club.id %>" class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline">
                    View Details &rarr;
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<% if (metrics.eventsPerMonth && metrics.eventsPerMonth.length > 0) { %>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const ctx = document.getElementById('monthlyTrendChart').getContext('2d');
    const trendData = <%- JSON.stringify(metrics.eventsPerMonth) %>;

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: trendData.map(d => d.month),
        datasets: [{
          label: 'Events Held',
          data: trendData.map(d => d.count),
          borderColor: '#6366f1',
          backgroundColor: 'rgba(99, 102, 241, 0.1)',
          fill: true,
          tension: 0.3,
          pointRadius: 5
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: { beginAtZero: true, ticks: { precision: 0 } }
        }
      }
    });
  });
</script>
<% } %>

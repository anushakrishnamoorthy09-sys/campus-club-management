<div class="max-w-xl mx-auto py-8 sm:py-12">
  <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 sm:p-8 shadow-xl">
    
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-indigo-600 text-white font-black text-2xl mb-3 shadow-lg shadow-indigo-500/20">
        C
      </div>
      <h2 class="text-2xl font-bold text-white tracking-tight">Complete Student Profile</h2>
      <p class="text-sm text-slate-400 mt-1">Provide your institutional details to finalize your Google Student Onboarding</p>
    </div>

    <!-- Google Account Info Card -->
    <div class="mb-6 p-4 rounded-xl bg-slate-900 border border-slate-700 flex items-center space-x-3">
      <div class="p-2 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-indigo-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
      </div>
      <div>
        <div class="text-xs text-slate-400">Google Account</div>
        <div class="text-sm font-semibold text-white"><%= user.full_name %> (<%= user.email %>)</div>
      </div>
    </div>

    <% if (error) { %>
      <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-center space-x-2">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/complete-profile" method="POST" class="space-y-5">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

      <!-- RA Number -->
      <div>
        <label for="raNumber" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
          RA Number <span class="text-rose-400">*</span> (15 Alphanumeric Characters)
        </label>
        <input 
          type="text" 
          id="raNumber" 
          name="raNumber" 
          value="<%= typeof formData !== 'undefined' && formData.raNumber ? formData.raNumber : '' %>"
          required 
          maxlength="15"
          pattern="^[A-Za-z0-9]{15}$"
          placeholder="e.g. RA2411003010001"
          class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition font-mono uppercase"
        >
        <p class="text-xs text-slate-500 mt-1">Permanent identity bound to your student record. Immutable once set.</p>
      </div>

      <!-- Department & Section -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="department" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Department <span class="text-rose-400">*</span>
          </label>
          <input 
            type="text" 
            id="department" 
            name="department" 
            value="<%= typeof formData !== 'undefined' && formData.department ? formData.department : '' %>"
            required 
            placeholder="e.g. Computer Science"
            class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition"
          >
        </div>

        <div>
          <label for="section" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Section <span class="text-rose-400">*</span>
          </label>
          <input 
            type="text" 
            id="section" 
            name="section" 
            value="<%= typeof formData !== 'undefined' && formData.section ? formData.section : '' %>"
            required 
            placeholder="e.g. A1"
            class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition"
          >
        </div>
      </div>

      <!-- Year of Study -->
      <div>
        <label for="yearOfStudy" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
          Year of Study <span class="text-rose-400">*</span>
        </label>
        <select 
          id="yearOfStudy" 
          name="yearOfStudy" 
          required 
          class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition"
        >
          <option value="" disabled <%= !formData || !formData.yearOfStudy ? 'selected' : '' %>>Select Current Academic Year</option>
          <option value="1" <%= formData && formData.yearOfStudy == '1' ? 'selected' : '' %>>1st Year</option>
          <option value="2" <%= formData && formData.yearOfStudy == '2' ? 'selected' : '' %>>2nd Year</option>
          <option value="3" <%= formData && formData.yearOfStudy == '3' ? 'selected' : '' %>>3rd Year</option>
          <option value="4" <%= formData && formData.yearOfStudy == '4' ? 'selected' : '' %>>4th Year</option>
          <option value="5" <%= formData && formData.yearOfStudy == '5' ? 'selected' : '' %>>5th Year</option>
        </select>
      </div>

      <!-- Class Mentor Dropdown -->
      <div>
        <label for="classMentorId" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
          Assigned Class Mentor <span class="text-rose-400">*</span>
        </label>
        <select 
          id="classMentorId" 
          name="classMentorId" 
          required 
          class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition"
        >
          <option value="" disabled <%= !formData || !formData.classMentorId ? 'selected' : '' %>>Select Assigned Class Mentor</option>
          <% if (typeof facultyMentors !== 'undefined' && facultyMentors.length > 0) { %>
            <% facultyMentors.forEach(mentor => { %>
              <option value="<%= mentor.faculty_user_id %>" <%= formData && formData.classMentorId == mentor.faculty_user_id ? 'selected' : '' %>>
                <%= mentor.full_name %> (<%= mentor.department %> - <%= mentor.designation %>)
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <button 
        type="submit" 
        class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl text-sm transition shadow-lg shadow-indigo-600/30 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900"
      >
        Complete Onboarding & Access Dashboard
      </button>
    </form>

  </div>
</div>

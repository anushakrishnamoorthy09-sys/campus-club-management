<div class="space-y-6 max-w-4xl mx-auto">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-700 pb-4">
    <div>
      <h1 class="text-2xl font-bold text-white tracking-tight flex items-center gap-2">
        <span>Notification Centre</span>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="px-2 py-0.5 text-xs font-mono font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-full">
            <%= unreadCount %> unread
          </span>
        <% } %>
      </h1>
      <p class="text-slate-400 text-sm">System updates, OD application decisions, event notifications, and role assignments</p>
    </div>

    <!-- Mark All as Read Button -->
    <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
      <form action="/notifications/read-all" method="POST">
        <button type="submit" class="px-3.5 py-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-600 text-xs font-semibold text-slate-200 hover:text-white rounded-lg transition shadow-sm flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Mark All as Read
        </button>
      </form>
    <% } %>
  </div>

  <!-- Filter Tabs -->
  <div class="flex items-center space-x-2 border-b border-slate-800 pb-2">
    <a href="/notifications?filter=all" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg transition <%= typeof filter === 'undefined' || filter === 'all' ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800' %>">
      All Notifications
    </a>
    <a href="/notifications?filter=unread" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg transition <%= typeof filter !== 'undefined' && filter === 'unread' ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800' %>">
      Unread Only
    </a>
  </div>

  <!-- Notifications List -->
  <% if (typeof notifications !== 'undefined' && notifications && notifications.length > 0) { %>
    <div class="space-y-3">
      <% notifications.forEach(notif => { %>
        <div class="p-4 bg-slate-800/60 border <%= notif.is_read ? 'border-slate-700/40 opacity-75' : 'border-indigo-500/40 bg-slate-800/90 shadow-lg shadow-indigo-950/20' %> rounded-2xl transition group flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          
          <div class="flex items-start space-x-3.5 flex-grow">
            <!-- Type Icon Badge -->
            <div class="mt-1 p-2 rounded-xl border flex-shrink-0 <%= 
              notif.type === 'EVENT' ? 'bg-sky-500/10 border-sky-500/30 text-sky-400' :
              notif.type.includes('OD') ? 'bg-amber-500/10 border-amber-500/30 text-amber-400' :
              notif.type.includes('ROLE') || notif.type.includes('MENTOR') ? 'bg-purple-500/10 border-purple-500/30 text-purple-400' :
              'bg-slate-700/50 border-slate-600 text-slate-300'
            %>">
              <% if (notif.type === 'EVENT') { %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <% } else if (notif.type.includes('OD')) { %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <% } else if (notif.type.includes('ROLE') || notif.type.includes('MENTOR')) { %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              <% } else { %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <% } %>
            </div>

            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <a href="/notifications/<%= notif.id %>/click" class="text-sm font-bold text-white hover:text-indigo-300 transition">
                  <%= notif.title %>
                </a>
                <% if (!notif.is_read) { %>
                  <span class="px-1.5 py-0.5 text-[10px] font-bold bg-indigo-500 text-white rounded">NEW</span>
                <% } %>
              </div>

              <p class="text-xs text-slate-300 leading-relaxed"><%= notif.message %></p>
              <div class="text-[11px] font-mono text-slate-500 pt-1">
                <%= new Date(notif.created_at).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) %>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center space-x-2 flex-shrink-0 self-end sm:self-center">
            <% if (notif.link_url) { %>
              <a href="/notifications/<%= notif.id %>/click" class="px-3 py-1.5 bg-indigo-600/20 hover:bg-indigo-600/30 border border-indigo-500/30 text-indigo-300 hover:text-white text-xs font-semibold rounded-lg transition">
                View &rarr;
              </a>
            <% } %>

            <% if (!notif.is_read) { %>
              <form action="/notifications/<%= notif.id %>/read" method="POST" class="inline">
                <button type="submit" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-600 border border-slate-600 text-slate-300 hover:text-white text-xs font-semibold rounded-lg transition">
                  Mark Read
                </button>
              </form>
            <% } %>
          </div>

        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="p-12 text-center bg-slate-800/40 border border-slate-700/40 rounded-2xl space-y-3">
      <svg class="w-12 h-12 text-slate-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
      </svg>
      <div class="text-sm font-semibold text-slate-300">No notifications found</div>
      <p class="text-xs text-slate-500">You are all caught up! New workflow notifications will appear here.</p>
    </div>
  <% } %>
</div>
